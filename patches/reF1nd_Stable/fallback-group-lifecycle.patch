--- a/protocol/group/fallback.go
+++ b/protocol/group/fallback.go
@@ -379,3 +379,18 @@ func (s *Fallback) addToBlacklist(tag string) {
 		s.blacklist[tag] = time.Now().Add(s.blacklistTimeout)
 	}
 }
+
+// Start implements adapter.Lifecycle (the scope-based lifecycle used by the
+// reF1nd-stable outbound manager). The stage guard matches upstream groups: the
+// member table is resolved at StartStateStart, once every member has started.
+//
+// 2026-10-10: this replaced a plain `Start() error` shim. Upstream removed the
+// plain-starter fallback branch from adapter/outbound.Manager.startOutbounds --
+// it now type-asserts adapter.Lifecycle and silently `continue`s otherwise, so
+// the shim stopped being called and the member table was never resolved.
+func (s *Fallback) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	return s.start()
+}
