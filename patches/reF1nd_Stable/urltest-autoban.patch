@@ -0,0 +1,1340 @@
+package group
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"math"
+	"math/rand"
+	"net"
+	"net/http"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/common/control"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/filemanager"
+)
+
+// AutoBan v3: sliding-window health scoring + passive circuit breaker + active
+// exponential-backoff recovery.
+//
+// Differences from v2:
+//   - No longer depends on fixed check_times for life/death decisions.
+//   - Each node has an EWMA health score (0..100) that combines success/failure
+//     and latency. A single success no longer fully resets the history.
+//   - A single failure still immediately makes the node Striked (circuit
+//     breaker). Repeated failures push the score down; when the score is below
+//     BanThreshold, or ConsecutiveFails reaches FailThreshold, the node is
+//     treated as banned.
+//   - Banned/striked nodes are actively re-probed with exponential backoff and
+//     randomized jitter, so recovery does not depend on user traffic.
+//   - Pre-flight network probe uses multiple 204 endpoints (domestic first for
+//     China direct connections) and races them.
+//   - State is keyed by a normalized tag so simple subscription renames such as
+//     "HK-01" -> "HK-01 | 1.5x" do not orphan the health record.
+type AutoBan struct {
+	access sync.RWMutex
+	ctx    context.Context
+
+	nodes     map[string]*nodeState
+	threshold int // hard consecutive-failure threshold
+	path      string
+	times     []time.Time
+	pinned    map[string]bool
+
+	allTagsFunc func() []string
+	testFunc    func(ctx context.Context, tag string) (uint16, bool, bool)
+	onBan       func(tag string)
+	onUnban     func(tag string)
+	logger      log.Logger
+
+	checking atomic.Bool
+
+	closed    chan struct{}
+	startOnce sync.Once
+	closeOnce sync.Once
+
+	// Direct network pre-flight probe
+	probeURLs      []string
+	probeTimeout   time.Duration
+	probeInterval  time.Duration
+	httpClient     *http.Client
+	healthMu       sync.Mutex
+	healthOK       bool
+	healthChecked  time.Time
+
+	// Active recovery loop
+	recoveryInterval time.Duration
+	initialBackoff   time.Duration
+	maxBackoff       time.Duration
+
+	// Health scoring
+	banThreshold     float64
+	recoverThreshold float64
+	maxLatencyMs     float64
+	decayHalfLife    time.Duration
+	staleTTL         time.Duration
+	batchMode         int
+	recoverSuccesses  int
+	flushDelay        time.Duration
+	dirty             bool
+	flushTimer        *time.Timer
+	stopped           bool
+	recentResults     []resultSample
+	lastSweepAt       time.Time
+	cooldown          time.Duration
+	summaryMu         sync.Mutex
+	lastSummaryAt     time.Time
+}
+
+type nodeState struct {
+	Key                 string    `json:"key"`
+	Tag                 string    `json:"tag,omitempty"`
+	Score               float64   `json:"score"`
+	Banned              bool      `json:"banned"`
+	LastFailAt          time.Time `json:"last_fail_at,omitempty"`
+	LastSuccessAt       time.Time `json:"last_success_at,omitempty"`
+	LastUpdate          time.Time `json:"last_update,omitempty"`
+	LastDecay           time.Time `json:"last_decay,omitempty"`
+	LastProbeAt         time.Time `json:"last_probe_at,omitempty"`
+	NextProbeAt         time.Time `json:"next_probe_at,omitempty"`
+	ConsecutiveFails    int       `json:"consecutive_fails"`
+	ConsecutiveSuccesses int      `json:"consecutive_successes"`
+	Backoff             time.Duration `json:"backoff,omitempty"`
+}
+
+// AutoBanOptions is the constructor input for AutoBan v3.
+type resultSample struct {
+	at time.Time
+	ok bool
+}
+
+type AutoBanOptions struct {
+	Threshold         int
+	Times             []time.Time // optional daily sweep times ("big exam")
+	Cooldown          time.Duration // deprecated
+	Path              string
+	ProbeURLs         []string
+	ProbeTimeout      time.Duration
+	RecoveryInterval  time.Duration
+	ProbeInterval     time.Duration // network pre-flight cache TTL; 0 = default
+	InitialBackoff    time.Duration
+	MaxBackoff        time.Duration
+	BanThreshold      int
+	RecoverThreshold  int
+	MaxLatency        time.Duration
+	RecoverSuccesses  int
+	FlushDelay        time.Duration
+	PinnedTags        []string
+}
+
+// AutoBanNodeStatus is a stable snapshot for upper-layer UI / dashboard display.
+type AutoBanNodeStatus struct {
+	Tag                 string    `json:"tag"`
+	Key                 string    `json:"key"`
+	Banned              bool      `json:"banned"`
+	Striked             bool      `json:"striked"`
+	Score               float64   `json:"score"`
+	ConsecutiveFails    int       `json:"consecutive_fails"`
+	ConsecutiveSuccesses int      `json:"consecutive_successes"`
+	LastFail            time.Time `json:"last_fail,omitempty"`
+	LastSuccess         time.Time `json:"last_success,omitempty"`
+	NextProbe           time.Time `json:"next_probe,omitempty"`
+}
+
+const (
+	defaultAutoBanFailThreshold     = 5
+	defaultAutoBanProbeTimeout      = 3 * time.Second
+	defaultAutoBanStrikeCooldown    = 5 * time.Minute
+	defaultAutoBanProbeInterval     = 30 * time.Second
+	defaultAutoBanSummaryInterval   = 30 * time.Minute
+	defaultAutoBanRecoveryInterval  = 1 * time.Minute
+	defaultAutoBanInitialBackoff    = 1 * time.Minute
+	defaultAutoBanMaxBackoff        = 30 * time.Minute
+	defaultAutoBanBanThreshold      = 25.0
+	defaultAutoBanRecoverThreshold  = 60.0
+	defaultAutoBanMaxLatency        = 1000 * time.Millisecond
+	defaultAutoBanDecayHalfLife     = 24 * time.Hour
+	defaultAutoBanStaleTTL          = 7 * 24 * time.Hour
+	defaultAutoBanRecoverSuccesses   = 2
+	defaultAutoBanFlushDelay         = 3 * time.Second
+	massFailWindow                    = 2 * time.Minute
+	massFailMinSamplesFloor           = 3
+	massFailRatio                     = 0.8
+	defaultAutoBanNeutralScore      = 80.0
+	defaultAutoBanInitialScore      = 100.0
+	defaultAutoBanSuccessAlpha      = 0.3
+	defaultAutoBanFailureAlpha      = 0.4
+)
+
+var defaultAutoBanProbeURLs = []string{
+	// 国内厂商/运营商高可用 204 探针：全部使用 HTTPS，避免明文 HTTP 被
+	// 商场/小区宽带的运营商劫持、插 JS 或 302 导致误判断网。
+	"https://connect.rom.miui.com/generate_204",
+	"https://connectivitycheck.platform.hicloud.com/generate_204",
+}
+
+func NewAutoBan(ctx context.Context, options AutoBanOptions) *AutoBan {
+	if options.Threshold <= 0 {
+		options.Threshold = defaultAutoBanFailThreshold
+	}
+	if options.ProbeTimeout <= 0 {
+		options.ProbeTimeout = defaultAutoBanProbeTimeout
+	}
+	if options.RecoveryInterval <= 0 {
+		options.RecoveryInterval = defaultAutoBanRecoveryInterval
+	}
+	if options.InitialBackoff <= 0 {
+		options.InitialBackoff = defaultAutoBanInitialBackoff
+	}
+	if options.MaxBackoff <= 0 {
+		options.MaxBackoff = defaultAutoBanMaxBackoff
+	}
+	if options.MaxBackoff < options.InitialBackoff {
+		options.MaxBackoff = options.InitialBackoff
+	}
+	banThreshold := float64(options.BanThreshold)
+	if banThreshold <= 0 {
+		banThreshold = defaultAutoBanBanThreshold
+	}
+	recoverThreshold := float64(options.RecoverThreshold)
+	if recoverThreshold <= 0 {
+		recoverThreshold = defaultAutoBanRecoverThreshold
+	}
+	if recoverThreshold <= banThreshold {
+		recoverThreshold = banThreshold + 20
+	}
+	recoverSuccesses := options.RecoverSuccesses
+	if recoverSuccesses <= 0 {
+		recoverSuccesses = defaultAutoBanRecoverSuccesses
+	}
+	cooldown := options.Cooldown
+	if cooldown <= 0 {
+		cooldown = defaultAutoBanStrikeCooldown
+	}
+	flushDelay := options.FlushDelay
+	if flushDelay <= 0 {
+		flushDelay = defaultAutoBanFlushDelay
+	}
+	maxLatency := options.MaxLatency
+	if maxLatency <= 0 {
+		maxLatency = defaultAutoBanMaxLatency
+	}
+	probeURLs := append([]string(nil), options.ProbeURLs...)
+	if len(probeURLs) == 0 {
+		probeURLs = append(probeURLs, defaultAutoBanProbeURLs...)
+	}
+	sortedTimes := append([]time.Time(nil), options.Times...)
+	sort.Slice(sortedTimes, func(i, j int) bool {
+		if sortedTimes[i].Hour() != sortedTimes[j].Hour() {
+			return sortedTimes[i].Hour() < sortedTimes[j].Hour()
+		}
+		return sortedTimes[i].Minute() < sortedTimes[j].Minute()
+	})
+	pinned := make(map[string]bool, len(options.PinnedTags))
+	for _, tag := range options.PinnedTags {
+		pinned[normalizeTagKey(tag)] = true
+	}
+	probeInterval := options.ProbeInterval
+	if probeInterval <= 0 {
+		probeInterval = defaultAutoBanProbeInterval
+	}
+	return &AutoBan{
+		ctx:              ctx,
+		nodes:            make(map[string]*nodeState),
+		threshold:        options.Threshold,
+		times:            sortedTimes,
+		pinned:           pinned,
+		path:             options.Path,
+		probeURLs:        probeURLs,
+		probeTimeout:     options.ProbeTimeout,
+		probeInterval:    probeInterval,
+		recoveryInterval: options.RecoveryInterval,
+		initialBackoff:   options.InitialBackoff,
+		maxBackoff:       options.MaxBackoff,
+		banThreshold:     banThreshold,
+		recoverThreshold: recoverThreshold,
+		maxLatencyMs:     float64(maxLatency.Milliseconds()),
+		decayHalfLife:    defaultAutoBanDecayHalfLife,
+		staleTTL:         defaultAutoBanStaleTTL,
+		closed:            make(chan struct{}),
+		recoverSuccesses:  recoverSuccesses,
+		flushDelay:        flushDelay,
+		cooldown:          cooldown,
+	}
+}
+
+// newProtectedHTTPClient builds an HTTP client whose dialer is protected by the
+// platform NetworkManager. On Android this calls through to VpnService.protect(),
+// so pre-flight probes bypass the TUN virtual interface and reach the physical
+// network directly.
+func newProtectedHTTPClient(ctx context.Context, timeout time.Duration) *http.Client {
+	dialer := &net.Dialer{
+		Timeout:   timeout,
+		KeepAlive: 30 * time.Second,
+	}
+	if networkManager := service.FromContext[adapter.NetworkManager](ctx); networkManager != nil {
+		if protectFunc := networkManager.ProtectFunc(); protectFunc != nil {
+			dialer.Control = control.Append(dialer.Control, protectFunc)
+		}
+	}
+	return &http.Client{
+		Timeout: timeout,
+		Transport: &http.Transport{
+			DialContext:       dialer.DialContext,
+			DisableKeepAlives: true,
+		},
+	}
+}
+
+// ensureHTTPClient lazily creates the protected HTTP client. Construction is
+// deferred until first use because NetworkManager may not be injected into the
+// service context when NewAutoBan is called during early startup.
+func (a *AutoBan) ensureHTTPClient() {
+	if a.httpClient == nil {
+		a.httpClient = newProtectedHTTPClient(a.ctx, a.probeTimeout)
+	}
+}
+
+// Start launches the active recovery loop. It is idempotent.
+func (a *AutoBan) Start() {
+	a.startOnce.Do(func() {
+		if a.logger != nil && a.threshold > 3 {
+			a.logger.Warn("auto_ban: fail_threshold=", a.threshold, " but score-based ban may trigger earlier; consider fail_threshold<=3 or adjust ban_threshold/recover_threshold")
+		}
+		if a.logger != nil && a.cooldown > 0 {
+			a.logger.Warn("auto_ban: fail_cooldown is set but deprecated; v3 uses EWMA time decay and ignores this option")
+		}
+		go a.recoveryLoop()
+		if len(a.times) > 0 {
+			go a.sweepLoop()
+		}
+	})
+}
+
+// Close stops the active recovery loop and flushes any pending state.
+// It is idempotent and safe for concurrent callers.
+func (a *AutoBan) Close() {
+	a.closeOnce.Do(func() {
+		close(a.closed)
+		var state *autoBanStateV3
+		a.access.Lock()
+		a.stopped = true
+		if a.flushTimer != nil {
+			a.flushTimer.Stop()
+			a.flushTimer = nil
+		}
+		if a.dirty {
+			a.dirty = false
+			s := a.snapshotStateLocked()
+			state = &s
+		}
+		a.access.Unlock()
+		if state != nil {
+			a.writeStateSnapshot(*state)
+		}
+	})
+}
+
+// normalizeTagKey returns a stable state key for a subscription tag.
+// It only performs safe normalization: trim, lowercase, collapse whitespace
+// and drop control characters. It deliberately does NOT merge different
+// multiplier lines such as "HK-01 | 0.5x" and "HK-01 | 2.0x", because those
+// are separate physical servers in most subscription providers.
+func normalizeTagKey(tag string) string {
+	s := strings.ToLower(strings.TrimSpace(tag))
+	var b strings.Builder
+	for _, r := range s {
+		if r < 0x20 || r == 0x7f {
+			continue
+		}
+		b.WriteRune(r)
+	}
+	// Remove ALL whitespace so "HK-01 | 1.5x" and "HK-01|1.5x" share the same key,
+	// while different multiplier lines still remain distinct.
+	return strings.Join(strings.Fields(b.String()), "")
+}
+
+func (a *AutoBan) keyOf(tag string) string {
+	return normalizeTagKey(tag)
+}
+
+func (a *AutoBan) getOrCreateLocked(tag string) *nodeState {
+	key := a.keyOf(tag)
+	n := a.nodes[key]
+	if n == nil {
+		n = &nodeState{
+			Key:   key,
+			Tag:   tag,
+			Score: defaultAutoBanInitialScore,
+		}
+		a.nodes[key] = n
+	}
+	if n.Tag != tag {
+		n.Tag = tag // keep last-seen display tag
+	}
+	return n
+}
+
+func (a *AutoBan) getLocked(tag string) *nodeState {
+	return a.nodes[a.keyOf(tag)]
+}
+
+func (a *AutoBan) isPinnedKeyLocked(key string) bool {
+	return a.pinned[key]
+}
+
+// Pinned reports whether the node is user-pinned (manual selection exemption).
+func (a *AutoBan) Pinned(tag string) bool {
+	a.access.RLock()
+	defer a.access.RUnlock()
+	return a.isPinnedKeyLocked(a.keyOf(tag))
+}
+
+// Pin adds a manual-selection exemption. Pinned nodes are never Banned, though
+// they may still be temporarily Striked after an actual failure.
+func (a *AutoBan) Pin(tag string) {
+	key := a.keyOf(tag)
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.pinned == nil {
+		a.pinned = make(map[string]bool)
+	}
+	if !a.pinned[key] {
+		a.pinned[key] = true
+		a.dirty = true
+		a.saveLocked()
+	}
+}
+
+// Unpin removes a manual-selection exemption.
+func (a *AutoBan) Unpin(tag string) {
+	key := a.keyOf(tag)
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.pinned[key] {
+		delete(a.pinned, key)
+		a.dirty = true
+		a.saveLocked()
+	}
+}
+
+func (a *AutoBan) inFailureLocked(n *nodeState) bool {
+	return n.ConsecutiveFails > 0 || (!n.LastFailAt.IsZero() && !n.LastSuccessAt.After(n.LastFailAt))
+}
+
+// decayLocked applies time-based mean reversion toward the neutral score.
+// This prevents one old bad day from permanently killing a node. Nodes that are
+// still in a failure state are capped below banThreshold so time alone cannot
+// resurrect a dead node; a real successful probe is required.
+func (a *AutoBan) decayLocked(n *nodeState, now time.Time) {
+	if n.LastDecay.IsZero() {
+		n.LastDecay = now
+		return
+	}
+	dt := now.Sub(n.LastDecay)
+	if dt <= 0 {
+		return
+	}
+	factor := math.Exp(-float64(dt) / float64(a.decayHalfLife))
+	n.Score = defaultAutoBanNeutralScore + (n.Score-defaultAutoBanNeutralScore)*factor
+	if n.Score < 0 {
+		n.Score = 0
+	}
+	if n.Score > 100 {
+		n.Score = 100
+	}
+	if n.Banned && a.banThreshold > 1 && n.Score > a.banThreshold-1 {
+		n.Score = a.banThreshold - 1
+	}
+	n.LastDecay = now
+}
+
+func (a *AutoBan) quality(delay uint16) float64 {
+	if delay == 0 {
+		return 1
+	}
+	if a.maxLatencyMs <= 0 {
+		return 1
+	}
+	q := 1 - float64(delay)/a.maxLatencyMs
+	if q < 0 {
+		q = 0
+	}
+	return q
+}
+
+func (a *AutoBan) bannedLocked(n *nodeState, now time.Time) bool {
+	if a.isPinnedKeyLocked(n.Key) {
+		return false
+	}
+	a.decayLocked(n, now)
+	if n.Banned {
+		// Already in banned state: require real recovery (score above
+		// recoverThreshold and several consecutive successes) before clearing.
+		if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+			return true
+		}
+		if n.Score < a.recoverThreshold {
+			return true
+		}
+		if n.ConsecutiveSuccesses < a.recoverSuccesses {
+			return true
+		}
+		n.Banned = false
+		return false
+	}
+	// Enter banned state only when the node is truly bad, not merely Striked.
+	if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+		n.Banned = true
+		return true
+	}
+	return false
+}
+
+func (a *AutoBan) strikedLocked(n *nodeState) bool {
+	if n.LastFailAt.IsZero() {
+		return false
+	}
+	// Temporary strike cooldown: an old single failure should not permanently
+	// block a node across restarts or long idle periods.
+	if a.cooldown > 0 && time.Since(n.LastFailAt) > a.cooldown {
+		return false
+	}
+	if !n.LastSuccessAt.IsZero() && n.LastSuccessAt.After(n.LastFailAt) {
+		return false
+	}
+	if n.ConsecutiveFails > 0 {
+		return true
+	}
+	// Hysteresis: a single lucky success after a failure is not enough to
+	// immediately route traffic back. Require a few consecutive successes.
+	if n.ConsecutiveSuccesses < a.recoverSuccesses {
+		return true
+	}
+	return false
+}
+
+func (a *AutoBan) blockedLocked(n *nodeState, now time.Time) bool {
+	return a.bannedLocked(n, now) || a.strikedLocked(n)
+}
+
+// RecordResult feeds a passive probe result (regular interval or manual test).
+// ok=false is ignored when the direct network probe says the local network is
+// down, avoiding mass environmental misattribution.
+func (a *AutoBan) RecordResult(tag string, delay uint16, ok bool) {
+	// Network health is checked by batch entry points (urlTest, recoveryLoop,
+	// runScheduledSweep). Per-result probing here would cause probe storms.
+	now := time.Now()
+	var banCb, unbanCb func(string)
+	a.access.Lock()
+	banCb, unbanCb = a.recordResultLocked(tag, delay, ok, now)
+	a.access.Unlock()
+	if banCb != nil {
+		banCb(tag)
+	}
+	if unbanCb != nil {
+		unbanCb(tag)
+	}
+}
+
+func (a *AutoBan) recordResultLocked(tag string, delay uint16, ok bool, now time.Time) (banCb func(string), unbanCb func(string)) {
+	if a.stopped {
+		return nil, nil
+	}
+	a.recordResultSampleLocked(now, ok)
+	n := a.getOrCreateLocked(tag)
+	wasBanned := a.bannedLocked(n, now)
+	wasStriked := a.strikedLocked(n)
+
+	if ok {
+		q := a.quality(delay)
+		target := q * 100
+		n.Score += defaultAutoBanSuccessAlpha * (target - n.Score)
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		if n.Score > 100 {
+			n.Score = 100
+		}
+		n.LastSuccessAt = now
+		n.LastProbeAt = now
+		n.ConsecutiveFails = 0
+		n.ConsecutiveSuccesses++
+		if n.ConsecutiveSuccesses >= a.recoverSuccesses && n.Score < a.recoverThreshold {
+			n.Score = a.recoverThreshold
+		}
+		n.Backoff = 0
+		n.NextProbeAt = time.Time{}
+	} else if a.massFailureLocked(now) {
+		// Mass environment failure (GFW/QoS/network switch): mark the node
+		// temporarily Striked but do NOT advance ban score/backoff. This prevents
+		// a whole subscription from being permanently banned during an outage.
+		n.LastFailAt = now
+		n.LastProbeAt = now
+		n.ConsecutiveSuccesses = 0
+	} else {
+		n.ConsecutiveFails++
+		penalty := defaultAutoBanFailureAlpha * (1 + 0.25*float64(n.ConsecutiveFails-1))
+		if penalty > 1 {
+			penalty = 1
+		}
+		n.Score -= penalty * n.Score
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		n.LastFailAt = now
+		n.LastProbeAt = now
+		n.ConsecutiveSuccesses = 0
+		if n.Backoff <= 0 {
+			n.Backoff = a.initialBackoff
+		} else {
+			n.Backoff *= 2
+			if n.Backoff > a.maxBackoff {
+				n.Backoff = a.maxBackoff
+			}
+		}
+		n.NextProbeAt = now.Add(n.Backoff + jitterDuration(n.Backoff))
+	}
+	n.LastUpdate = now
+	n.LastDecay = now
+
+	nowBanned := a.bannedLocked(n, now)
+	nowStriked := a.strikedLocked(n)
+	if !wasBanned && nowBanned && a.onBan != nil {
+		banCb = a.onBan
+	}
+	if wasBanned && !nowBanned && a.onUnban != nil {
+		unbanCb = a.onUnban
+	}
+	if !wasBanned && wasStriked && !nowStriked && a.onUnban != nil {
+		unbanCb = a.onUnban
+	}
+	a.saveLocked()
+	return
+}
+
+// bannedLockedNoDecay is a read-only version of bannedLocked for hot paths.
+// It does not perform time decay or mutate node state.
+func (a *AutoBan) bannedLockedNoDecay(n *nodeState) bool {
+	if a.isPinnedKeyLocked(n.Key) {
+		return false
+	}
+	if n.Banned {
+		if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+			return true
+		}
+		if n.Score < a.recoverThreshold {
+			return true
+		}
+		if n.ConsecutiveSuccesses < a.recoverSuccesses {
+			return true
+		}
+		return false
+	}
+	if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+		return true
+	}
+	return false
+}
+
+// IsBanned reports whether the node is currently treated as permanently banned.
+func (a *AutoBan) IsBanned(tag string) bool {
+	a.access.RLock()
+	defer a.access.RUnlock()
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	return a.bannedLockedNoDecay(n)
+}
+
+// Striked reports whether the node is currently in the temporary circuit-break state.
+func (a *AutoBan) Striked(tag string) bool {
+	a.access.RLock()
+	defer a.access.RUnlock()
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	return a.strikedLocked(n)
+}
+
+// Blocked is the combined predicate used by Select(): banned or currently struck.
+// It is read-only and safe for the hot routing path.
+func (a *AutoBan) Blocked(tag string) bool {
+	a.access.RLock()
+	defer a.access.RUnlock()
+	if a.isPinnedKeyLocked(a.keyOf(tag)) {
+		return false
+	}
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	return a.bannedLockedNoDecay(n) || a.strikedLocked(n)
+}
+
+func (a *AutoBan) recordResultSampleLocked(now time.Time, ok bool) {
+	a.recentResults = append(a.recentResults, resultSample{at: now, ok: ok})
+	cutoff := now.Add(-massFailWindow)
+	keep := 0
+	for keep < len(a.recentResults) && a.recentResults[keep].at.Before(cutoff) {
+		keep++
+	}
+	if keep > 0 {
+		a.recentResults = append([]resultSample(nil), a.recentResults[keep:]...)
+	}
+}
+
+func (a *AutoBan) massFailMinSamplesLocked() int {
+	n := len(a.nodes)
+	if a.allTagsFunc != nil {
+		if tags := a.allTagsFunc(); len(tags) > 0 {
+			n = len(tags)
+		}
+	}
+	minSamples := n / 2
+	if minSamples < massFailMinSamplesFloor {
+		minSamples = massFailMinSamplesFloor
+	}
+	return minSamples
+}
+
+func (a *AutoBan) massFailureLocked(now time.Time) bool {
+	minSamples := a.massFailMinSamplesLocked()
+	cutoff := now.Add(-massFailWindow)
+	var total, failed int
+	for _, sample := range a.recentResults {
+		if sample.at.Before(cutoff) {
+			continue
+		}
+		total++
+		if !sample.ok {
+			failed++
+		}
+	}
+	if total < minSamples {
+		// Not enough evidence to conclude a mass failure. Do NOT suppress
+		// individual node failures (otherwise a single dead node would be
+		// retried forever without being banned).
+		return false
+	}
+	return float64(failed)/float64(total) >= massFailRatio
+}
+
+// Snapshot returns a stable, sorted view of tracked node states for UI.
+func (a *AutoBan) Snapshot() []AutoBanNodeStatus {
+	now := time.Now()
+	a.access.Lock()
+	defer a.access.Unlock()
+
+	currentTagByKey := make(map[string]string)
+	if a.allTagsFunc != nil {
+		for _, tag := range a.allTagsFunc() {
+			currentTagByKey[a.keyOf(tag)] = tag
+		}
+	}
+	statuses := make([]AutoBanNodeStatus, 0, len(a.nodes))
+	for key, n := range a.nodes {
+		a.decayLocked(n, now)
+		tag := currentTagByKey[key]
+		if tag == "" {
+			tag = n.Tag
+		}
+		statuses = append(statuses, AutoBanNodeStatus{
+			Tag:                  tag,
+			Key:                  key,
+			Banned:               a.bannedLocked(n, now),
+			Striked:              a.strikedLocked(n),
+			Score:                n.Score,
+			ConsecutiveFails:     n.ConsecutiveFails,
+			ConsecutiveSuccesses: n.ConsecutiveSuccesses,
+			LastFail:             n.LastFailAt,
+			LastSuccess:          n.LastSuccessAt,
+			NextProbe:            n.NextProbeAt,
+		})
+	}
+	sort.Slice(statuses, func(i, j int) bool {
+		return statuses[i].Key < statuses[j].Key
+	})
+	return statuses
+}
+
+// recoveryLoop actively probes unhealthy nodes with exponential backoff and jitter.
+// This is the replacement for the old fixed check_times scheduler.
+func (a *AutoBan) recoveryLoop() {
+	// Initial short randomized delay avoids a thundering herd on startup.
+	select {
+	case <-a.closed:
+		return
+	case <-time.After(jitterDuration(a.recoveryInterval)):
+	}
+	for {
+		a.runRecoveryRound()
+		select {
+		case <-a.closed:
+			return
+		case <-time.After(a.recoveryInterval + jitterDuration(a.recoveryInterval)):
+		}
+	}
+}
+
+func (a *AutoBan) runRecoveryRound() {
+	if a.testFunc == nil || a.allTagsFunc == nil {
+		return
+	}
+	if !a.checking.CompareAndSwap(false, true) {
+		return
+	}
+	defer a.checking.Store(false)
+
+	tags := a.allTagsFunc()
+	now := time.Now()
+	var tasks []string
+
+	a.access.Lock()
+	currentKeys := make(map[string]bool, len(tags))
+	for _, tag := range tags {
+		key := a.keyOf(tag)
+		currentKeys[key] = true
+		n := a.getOrCreateLocked(tag)
+		a.decayLocked(n, now)
+		if a.blockedLocked(n, now) || (!n.LastProbeAt.IsZero() && n.Score < a.recoverThreshold) {
+			if n.NextProbeAt.IsZero() || !n.NextProbeAt.After(now) {
+				tasks = append(tasks, tag)
+			}
+		}
+	}
+	staleTTL := a.staleTTL
+	if staleTTL <= 0 {
+		staleTTL = defaultAutoBanStaleTTL
+	}
+	for key, n := range a.nodes {
+		if !currentKeys[key] && !n.LastUpdate.IsZero() && now.Sub(n.LastUpdate) > staleTTL {
+			delete(a.nodes, key)
+			a.dirty = true
+		}
+	}
+	if len(tasks) == 0 && a.dirty {
+		// Persist GC even when there is nothing to probe; otherwise removed
+		// subscription nodes would resurrect on restart.
+		a.saveLocked()
+	}
+	a.access.Unlock()
+
+	a.logSummary()
+	if len(tasks) == 0 {
+		// Idle group: no network preflight, no packets, no wakelock churn.
+		return
+	}
+	if !a.isNetworkHealthy() {
+		return
+	}
+	a.probeTags(tasks)
+}
+
+// logSummary emits one aggregated health line, at most once every
+// defaultAutoBanSummaryInterval. A single rolled-up line is far easier to scan
+// than per-node entries when diagnosing a ban storm.
+func (a *AutoBan) logSummary() {
+	if a.logger == nil {
+		return
+	}
+	a.summaryMu.Lock()
+	now := time.Now()
+	if !a.lastSummaryAt.IsZero() && now.Sub(a.lastSummaryAt) < defaultAutoBanSummaryInterval {
+		a.summaryMu.Unlock()
+		return
+	}
+	a.lastSummaryAt = now
+	a.summaryMu.Unlock()
+
+	a.access.Lock()
+	total := len(a.nodes)
+	banned, striked := 0, 0
+	scoreSum := 0.0
+	for _, n := range a.nodes {
+		scoreSum += n.Score
+		switch {
+		case a.bannedLocked(n, now):
+			banned++
+		case a.strikedLocked(n):
+			striked++
+		}
+	}
+	a.access.Unlock()
+
+	if total == 0 {
+		return
+	}
+	a.logger.Info("auto_ban: summary: ", total, " nodes, ", banned, " banned, ", striked, " striked, avg score ", int(scoreSum/float64(total)))
+}
+
+// probeTags runs the adaptive worker pool over the given tags and batches
+// state persistence into one debounced flush.
+func (a *AutoBan) probeTags(tags []string) {
+	a.access.Lock()
+	a.batchMode++
+	a.access.Unlock()
+	defer func() {
+		a.access.Lock()
+		a.batchMode--
+		if a.batchMode == 0 && a.dirty {
+			a.saveLocked()
+		}
+		a.access.Unlock()
+	}()
+
+	const (
+		minRecoveryWorkers = 4
+		maxRecoveryWorkers = 12
+	)
+	workerCount := minRecoveryWorkers
+	if len(tags) > 20 {
+		workerCount = 6
+	}
+	if len(tags) > 60 {
+		workerCount = 8
+	}
+	if len(tags) > 120 {
+		workerCount = maxRecoveryWorkers
+	}
+	if workerCount > len(tags) {
+		workerCount = len(tags)
+	}
+	if workerCount <= 0 {
+		return
+	}
+	taskCh := make(chan string)
+	var wg sync.WaitGroup
+	for i := 0; i < workerCount; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for tag := range taskCh {
+				delay, ok, exists := a.testFunc(a.ctx, tag)
+				if !exists {
+					continue
+				}
+				var banCb, unbanCb func(string)
+				a.access.Lock()
+				banCb, unbanCb = a.recordResultLocked(tag, delay, ok, time.Now())
+				a.access.Unlock()
+				if banCb != nil {
+					banCb(tag)
+				}
+				if unbanCb != nil {
+					unbanCb(tag)
+				}
+			}
+		}()
+	}
+	go func() {
+		defer close(taskCh)
+		for _, tag := range tags {
+			select {
+			case <-a.closed:
+				return
+			case taskCh <- tag:
+			}
+		}
+	}()
+	wg.Wait()
+}
+
+// sweepLoop implements the optional daily "big exam" schedule.
+func (a *AutoBan) sweepLoop() {
+	for {
+		if !a.lastSweepAt.IsZero() && time.Since(a.lastSweepAt) > time.Hour {
+			// Wall-clock catch-up after Android Doze / suspend: if we clearly
+			// missed a scheduled exam, run one immediately.
+			a.runScheduledSweep()
+			continue
+		}
+		next := a.nextCheckTime(time.Now())
+		wait := time.Until(next)
+		if wait > 2*time.Minute {
+			wait += jitterDuration(2 * time.Minute)
+		}
+		const maxSweepStep = 10 * time.Minute
+		if wait > maxSweepStep {
+			wait = maxSweepStep
+		}
+		if wait < 0 {
+			wait = 0
+		}
+		timer := time.NewTimer(wait)
+		select {
+		case <-a.closed:
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+		a.runScheduledSweep()
+	}
+}
+
+func (a *AutoBan) nextCheckTime(from time.Time) time.Time {
+	best := time.Time{}
+	for _, daily := range a.times {
+		today := time.Date(from.Year(), from.Month(), from.Day(), daily.Hour(), daily.Minute(), 0, 0, from.Location())
+		if !today.Before(from) && (best.IsZero() || today.Before(best)) {
+			best = today
+		}
+	}
+	if !best.IsZero() {
+		return best
+	}
+	tomorrow := from.AddDate(0, 0, 1)
+	minTime := a.times[0]
+	for _, daily := range a.times[1:] {
+		if daily.Hour() < minTime.Hour() || (daily.Hour() == minTime.Hour() && daily.Minute() < minTime.Minute()) {
+			minTime = daily
+		}
+	}
+	return time.Date(tomorrow.Year(), tomorrow.Month(), tomorrow.Day(), minTime.Hour(), minTime.Minute(), 0, 0, tomorrow.Location())
+}
+
+// runScheduledSweep probes ALL current nodes at the configured check_times,
+// bypassing backoff so a good node that was hit by evening congestion can be
+// vindicated in the next morning's global exam.
+func (a *AutoBan) runScheduledSweep() {
+	if a.testFunc == nil || a.allTagsFunc == nil {
+		return
+	}
+	if !a.lastSweepAt.IsZero() && time.Since(a.lastSweepAt) < time.Minute {
+		return
+	}
+	if !a.checking.CompareAndSwap(false, true) {
+		return
+	}
+	defer a.checking.Store(false)
+
+	if !a.isNetworkHealthy() {
+		return
+	}
+	a.lastSweepAt = time.Now()
+	tags := a.allTagsFunc()
+	if len(tags) == 0 {
+		return
+	}
+	a.probeTags(tags)
+}
+
+type autoBanStateV3 struct {
+	Nodes     map[string]*nodeState `json:"nodes"`
+	Pinned    []string              `json:"pinned"`
+	LastCheck time.Time             `json:"last_check"`
+}
+
+// legacyAutoBanState is the v2 file format, used only for migration.
+type legacyAutoBanState struct {
+	Banned     []string             `json:"banned"`
+	Strikes    map[string]int       `json:"strikes"`
+	LastFail   map[string]time.Time `json:"last_fail"`
+	LastStrike map[string]time.Time `json:"last_strike"`
+	LastCheck  time.Time            `json:"last_check"`
+}
+
+// Load restores state from the persistent JSON file and migrates v2 files.
+func (a *AutoBan) Load() error {
+	if a.path == "" {
+		return nil
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+
+	path := filemanager.BasePath(a.ctx, a.path)
+	content, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			// The primary file is legitimately absent on first run, but it can
+			// also be missing because a crash landed between the two renames in
+			// writeStateSnapshot. Prefer the backup before starting empty.
+			if a.loadBackupLocked(path) {
+				return nil
+			}
+			return nil
+		}
+		return E.Cause(err, "read autoban state")
+	}
+
+	var state autoBanStateV3
+	if err := json.Unmarshal(content, &state); err == nil && len(state.Nodes) > 0 {
+		a.nodes = state.Nodes
+		if a.nodes == nil {
+			a.nodes = make(map[string]*nodeState)
+		}
+		a.pinned = make(map[string]bool, len(state.Pinned))
+		for _, tag := range state.Pinned {
+			a.pinned[a.keyOf(tag)] = true
+		}
+		return nil
+	}
+
+	// Try legacy v2 format.
+	var legacy legacyAutoBanState
+	if err := json.Unmarshal(content, &legacy); err != nil {
+		// Corrupted file (e.g. power loss during write): do not block startup.
+		// Prefer the previous snapshot kept by writeStateSnapshot so ban history
+		// survives; only fall back to a clean state when there is no backup.
+		if a.loadBackupLocked(path) {
+			return nil
+		}
+		if a.logger != nil {
+			a.logger.Warn("auto_ban: corrupted state file, resetting: ", err)
+		}
+		a.nodes = make(map[string]*nodeState)
+		return nil
+	}
+	a.nodes = make(map[string]*nodeState)
+	now := time.Now()
+	for _, tag := range legacy.Banned {
+		key := a.keyOf(tag)
+		n := &nodeState{
+			Key:              key,
+			Tag:              tag,
+			Score:            0,
+			Banned:           true,
+			LastFailAt:       legacy.LastFail[tag],
+			LastUpdate:       now,
+			LastDecay:        now,
+			ConsecutiveFails: a.threshold,
+		}
+		a.nodes[key] = n
+	}
+	for tag, strikes := range legacy.Strikes {
+		key := a.keyOf(tag)
+		n := a.nodes[key]
+		if n == nil {
+			n = &nodeState{Key: key, Tag: tag, LastUpdate: now, LastDecay: now}
+			a.nodes[key] = n
+		}
+		n.Score = defaultAutoBanNeutralScore - float64(strikes)*10
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		if failAt, ok := legacy.LastFail[tag]; ok {
+			n.LastFailAt = failAt
+		}
+		n.ConsecutiveFails = strikes
+	}
+	return nil
+}
+
+// saveLocked marks state dirty and schedules a debounced asynchronous flush.
+// Caller must hold a.access. This prevents UFS/JSON write spam on mobile.
+func (a *AutoBan) saveLocked() {
+	if a.path == "" || a.stopped {
+		return
+	}
+	a.dirty = true
+	if a.batchMode > 0 {
+		return
+	}
+	if a.flushTimer == nil {
+		a.flushTimer = time.AfterFunc(a.flushDelay, a.flush)
+	}
+}
+
+// flush is the debounced disk writer. It snapshots state under the lock and
+// performs serialization + atomic file write WITHOUT holding the main lock.
+func (a *AutoBan) flush() {
+	var state *autoBanStateV3
+	a.access.Lock()
+	if a.flushTimer != nil {
+		a.flushTimer.Stop()
+		a.flushTimer = nil
+	}
+	if a.dirty {
+		a.dirty = false
+		s := a.snapshotStateLocked()
+		state = &s
+	}
+	a.access.Unlock()
+	if state != nil {
+		a.writeStateSnapshot(*state)
+	}
+}
+
+// snapshotStateLocked deep-copies the current state for lock-free I/O.
+func (a *AutoBan) snapshotStateLocked() autoBanStateV3 {
+	nodes := make(map[string]*nodeState, len(a.nodes))
+	for key, n := range a.nodes {
+		cp := *n
+		nodes[key] = &cp
+	}
+	pinned := make([]string, 0, len(a.pinned))
+	for key := range a.pinned {
+		pinned = append(pinned, key)
+	}
+	sort.Strings(pinned)
+	return autoBanStateV3{
+		Nodes:     nodes,
+		Pinned:    pinned,
+		LastCheck: time.Now(),
+	}
+}
+
+// writeStateSnapshot performs JSON serialization and atomic file write without
+// holding any AutoBan lock.
+func (a *AutoBan) writeStateSnapshot(state autoBanStateV3) {
+	content, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return
+	}
+	path := filemanager.BasePath(a.ctx, a.path)
+	tmpPath := path + ".tmp"
+	if err := os.WriteFile(tmpPath, content, 0o644); err != nil {
+		return
+	}
+	// Flush the temp file before it becomes visible under the target name.
+	// Without this, a crash or power loss right after the rename can leave a
+	// zero-length or truncated file, and the rename itself would look atomic.
+	if f, err := os.OpenFile(tmpPath, os.O_WRONLY, 0o644); err == nil {
+		_ = f.Sync()
+		_ = f.Close()
+	}
+	// Keep the previous good copy aside so Load() can fall back to it when the
+	// new file is ever unreadable (see loadBackupLocked).
+	_ = os.Rename(path, path+".bak")
+	_ = os.Rename(tmpPath, path)
+}
+
+// loadBackupLocked restores state from the ".bak" snapshot written by
+// writeStateSnapshot. It is only consulted after the primary state file fails
+// to parse, so a corrupted current file degrades to slightly-stale data instead
+// of wiping all ban history. Returns false when no usable backup exists.
+func (a *AutoBan) loadBackupLocked(path string) bool {
+	content, err := os.ReadFile(path + ".bak")
+	if err != nil {
+		return false
+	}
+	var state autoBanStateV3
+	if err := json.Unmarshal(content, &state); err != nil || len(state.Nodes) == 0 {
+		return false
+	}
+	a.nodes = state.Nodes
+	if a.nodes == nil {
+		a.nodes = make(map[string]*nodeState)
+	}
+	a.pinned = make(map[string]bool, len(state.Pinned))
+	for _, tag := range state.Pinned {
+		a.pinned[a.keyOf(tag)] = true
+	}
+	if a.logger != nil {
+		a.logger.Warn("auto_ban: state file unreadable, recovered previous snapshot from ", path+".bak")
+	}
+	return true
+}
+
+// NetworkHealthy reports whether the direct pre-flight probe currently thinks
+// the physical network is usable. Exposed for URLTestGroup.urlTest gating.
+func (a *AutoBan) NetworkHealthy() bool {
+	return a.isNetworkHealthy()
+}
+
+// isNetworkHealthy runs/caches a multi-target direct pre-flight probe.
+func (a *AutoBan) isNetworkHealthy() bool {
+	if len(a.probeURLs) == 0 {
+		return true
+	}
+	off := false
+	for _, u := range a.probeURLs {
+		if strings.EqualFold(u, "off") || strings.EqualFold(u, "none") {
+			off = true
+			break
+		}
+	}
+	if off {
+		return true
+	}
+
+	a.healthMu.Lock()
+	defer a.healthMu.Unlock()
+
+	if !a.healthChecked.IsZero() && time.Since(a.healthChecked) < a.probeInterval {
+		return a.healthOK
+	}
+
+	a.ensureHTTPClient()
+	ok := a.probeNetwork()
+	if !ok {
+		// Rebuild the protected client on the next attempt so network switches /
+		// VPN recreation pick up the current VpnService protection context.
+		a.httpClient = nil
+	}
+	changed := a.healthChecked.IsZero() || a.healthOK != ok
+	a.healthChecked = time.Now()
+	a.healthOK = ok
+	if changed && a.logger != nil {
+		if ok {
+			a.logger.Info("auto_ban: direct network probe ok")
+		} else {
+			a.logger.Warn("auto_ban: all direct network probes failed; skip failure accounting")
+		}
+	}
+	return ok
+}
+
+// probeNetwork races multiple 204 endpoints. Any 2xx response means the local
+// network is considered healthy.
+func (a *AutoBan) probeNetwork() bool {
+	ctx, cancel := context.WithTimeout(a.ctx, a.probeTimeout)
+	defer cancel()
+	results := make(chan bool, len(a.probeURLs))
+	for _, url := range a.probeURLs {
+		go func(u string) {
+			results <- a.probeOne(ctx, u)
+		}(url)
+	}
+	for range a.probeURLs {
+		if <-results {
+			return true
+		}
+	}
+	return false
+}
+
+func (a *AutoBan) probeOne(ctx context.Context, url string) bool {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return false
+	}
+	resp, err := a.httpClient.Do(req)
+	if err != nil {
+		return false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusNoContent {
+		return true
+	}
+	if resp.StatusCode != http.StatusOK {
+		return false
+	}
+	// Some captive portals return HTTP 200 with an HTML login page. A real
+	// generate_204 endpoint should return an empty body.
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+	return len(bytes.TrimSpace(body)) == 0
+}
+
+func jitterDuration(d time.Duration) time.Duration {
+	if d <= 0 {
+		return 0
+	}
+	maxJitter := d / 5
+	if maxJitter <= 0 {
+		maxJitter = time.Millisecond
+	}
+	return time.Duration(rand.Int63n(int64(maxJitter)))
+}
