diff --git a/protocol/group/autoban.go b/protocol/group/autoban.go
new file mode 100644
index 0000000..02e2b27
--- /dev/null
+++ b/protocol/group/autoban.go
@@ -0,0 +1,270 @@
+package group
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service/filemanager"
+)
+
+// AutoBan 实现基于多时段定时探测的节点淘汰与恢复：
+//   - 每天在设定的多个时刻（check_times，本地时区 "HH:MM"）各做一轮全量 urltest
+//   - 任一时段测试失败的节点被暂时禁用（跳过选择，等价于临时删除）
+//   - 后续时段测试成功即自动恢复
+//   - 连续 fail_threshold 个时段全部失败的节点被永久淘汰（banned，跳过选择且不再自动恢复）
+//   - 淘汰状态持久化到 JSON 文件（跨重启保留；文件由 filemanager 解析到
+//     SFA/libbox 工作目录，与 cache.db 同机制）
+type AutoBan struct {
+	access sync.Mutex
+	ctx    context.Context
+	// 淘汰阈值：连续失败达到该次数即永久淘汰
+	threshold int
+	// 每日检查时刻（本地时区）
+	times []time.Time
+	// 状态表：realTag -> 连续失败次数（达到阈值后记录为 -1 表示 banned）
+	strikes   map[string]int
+	banned    map[string]bool
+	lastCheck time.Time
+	// 持久化路径（空则不持久化）
+	path string
+	// 测试回调：由 URLTestGroup 注入，对单个出站做一次真实 urltest
+	testFunc func(ctx context.Context, tag string) (uint16, bool)
+	// 淘汰/恢复回调：由 URLTestGroup 注入（当前用于日志）
+	onBan    func(tag string)
+	onUnban  func(tag string)
+	checking bool
+	closed   chan struct{}
+}
+
+func NewAutoBan(ctx context.Context, threshold int, times []time.Time, path string) *AutoBan {
+	if threshold <= 0 {
+		threshold = 3
+	}
+	return &AutoBan{
+		ctx:       ctx,
+		threshold: threshold,
+		times:     times,
+		strikes:   make(map[string]int),
+		banned:    make(map[string]bool),
+		path:      path,
+		closed:    make(chan struct{}),
+	}
+}
+
+// Start 启动每日定时调度（goroutine，按 check_times 逐日对齐）
+func (a *AutoBan) Start() {
+	if len(a.times) == 0 {
+		return
+	}
+	go a.loop()
+}
+
+func (a *AutoBan) Close() {
+	select {
+	case <-a.closed:
+	default:
+		close(a.closed)
+	}
+}
+
+func (a *AutoBan) loop() {
+	for {
+		next := a.nextCheckTime(time.Now())
+		timer := time.NewTimer(time.Until(next))
+		select {
+		case <-a.closed:
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+		a.runScheduledCheck()
+	}
+}
+
+// nextCheckTime 计算从 from 起下一个检查时刻（含今日未到时刻）
+func (a *AutoBan) nextCheckTime(from time.Time) time.Time {
+	best := time.Time{}
+	for _, daily := range a.times {
+		// 今日该时刻
+		today := time.Date(from.Year(), from.Month(), from.Day(), daily.Hour(), daily.Minute(), 0, 0, from.Location())
+		if today.After(from) && (best.IsZero() || today.Before(best)) {
+			best = today
+		}
+	}
+	if !best.IsZero() {
+		return best
+	}
+	// 今日全部已过：取明日最早时刻
+	tomorrow := from.AddDate(0, 0, 1)
+	best = time.Date(tomorrow.Year(), tomorrow.Month(), tomorrow.Day(), a.times[0].Hour(), a.times[0].Minute(), 0, 0, tomorrow.Location())
+	for _, daily := range a.times[1:] {
+		cand := time.Date(tomorrow.Year(), tomorrow.Month(), tomorrow.Day(), daily.Hour(), daily.Minute(), 0, 0, tomorrow.Location())
+		if cand.Before(best) {
+			best = cand
+		}
+	}
+	return best
+}
+
+// runScheduledCheck 执行一轮全量测试并更新淘汰状态
+func (a *AutoBan) runScheduledCheck() {
+	if a.testFunc == nil {
+		return
+	}
+	a.access.Lock()
+	if a.checking {
+		a.access.Unlock()
+		return
+	}
+	a.checking = true
+	tags := make([]string, 0, len(a.strikes)+len(a.banned))
+	for tag := range a.banned {
+		tags = append(tags, tag)
+	}
+	seen := make(map[string]bool)
+	for tag := range a.strikes {
+		if !a.banned[tag] && !seen[tag] {
+			seen[tag] = true
+			tags = append(tags, tag)
+		}
+	}
+	a.access.Unlock()
+	// 逐个测试（banned 节点也参与：全部时段失败才淘汰，恢复机制要求继续探测）
+	for _, tag := range tags {
+		select {
+		case <-a.closed:
+			return
+		default:
+		}
+		_, ok := a.testFunc(a.ctx, tag)
+		a.access.Lock()
+		if ok {
+			if a.banned[tag] {
+				delete(a.banned, tag)
+				delete(a.strikes, tag)
+				if a.onUnban != nil {
+					a.onUnban(tag)
+				}
+			} else if a.strikes[tag] > 0 {
+				delete(a.strikes, tag)
+			}
+		} else {
+			a.strikes[tag]++
+			if a.strikes[tag] >= a.threshold && !a.banned[tag] {
+				a.banned[tag] = true
+				if a.onBan != nil {
+					a.onBan(tag)
+				}
+			}
+		}
+		a.access.Unlock()
+	}
+	a.access.Lock()
+	a.lastCheck = time.Now()
+	a.saveLocked()
+	a.checking = false
+	a.access.Unlock()
+}
+
+// RecordResult 供 URLTestGroup 在常规 interval 测试中同步结果：
+// 成功清零并恢复；失败只计数（不立即淘汰，阈值判定留给定时任务）
+func (a *AutoBan) RecordResult(tag string, ok bool) {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if ok {
+		if a.banned[tag] {
+			delete(a.banned, tag)
+			delete(a.strikes, tag)
+			if a.onUnban != nil {
+				a.onUnban(tag)
+			}
+		} else if a.strikes[tag] > 0 {
+			delete(a.strikes, tag)
+		}
+		return
+	}
+	a.strikes[tag]++
+	if a.strikes[tag] >= a.threshold && !a.banned[tag] {
+		a.banned[tag] = true
+		if a.onBan != nil {
+			a.onBan(tag)
+		}
+	}
+	a.saveLocked()
+}
+
+// IsBanned 节点是否被永久淘汰
+func (a *AutoBan) IsBanned(tag string) bool {
+	a.access.Lock()
+	defer a.access.Unlock()
+	return a.banned[tag]
+}
+
+// Striked 节点是否有未恢复的失败计数（暂时禁用中）
+func (a *AutoBan) Striked(tag string) bool {
+	a.access.Lock()
+	defer a.access.Unlock()
+	return a.strikes[tag] > 0
+}
+
+type autoBanState struct {
+	Banned    []string    `json:"banned"`
+	Strikes   map[string]int `json:"strikes"`
+	LastCheck time.Time   `json:"last_check"`
+}
+
+// Load 从持久化文件恢复状态
+func (a *AutoBan) Load() error {
+	if a.path == "" {
+		return nil
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+	path := filemanager.BasePath(a.ctx, a.path)
+	content, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return E.Cause(err, "read autoban state")
+	}
+	var state autoBanState
+	if err := json.Unmarshal(content, &state); err != nil {
+		return E.Cause(err, "parse autoban state")
+	}
+	a.banned = make(map[string]bool, len(state.Banned))
+	for _, tag := range state.Banned {
+		a.banned[tag] = true
+	}
+	a.strikes = state.Strikes
+	if a.strikes == nil {
+		a.strikes = make(map[string]int)
+	}
+	a.lastCheck = state.LastCheck
+	return nil
+}
+
+// saveLocked 持久化状态（需持锁调用）
+func (a *AutoBan) saveLocked() {
+	if a.path == "" {
+		return
+	}
+	state := autoBanState{
+		Banned:    make([]string, 0, len(a.banned)),
+		Strikes:   a.strikes,
+		LastCheck: a.lastCheck,
+	}
+	for tag := range a.banned {
+		state.Banned = append(state.Banned, tag)
+	}
+	content, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return
+	}
+	path := filemanager.BasePath(a.ctx, a.path)
+	_ = filemanager.WriteFile(a.ctx, path, content, 0o644)
+}
