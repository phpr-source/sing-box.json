+package route
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// resolveOutboundCycleMember satisfies adapter.Outbound. Only Tag() and
+// Network() are reached while resolving; the dial methods exist to complete the
+// interface.
+type resolveOutboundCycleMember struct {
+	outbound.Adapter
+}
+
+func (m *resolveOutboundCycleMember) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return nil, E.New("not implemented")
+}
+
+func (m *resolveOutboundCycleMember) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, E.New("not implemented")
+}
+
+// resolveOutboundCycleGroup is a minimal adapter.OutboundGroup whose Selected()
+// points at another group, so two of them form a cycle.
+type resolveOutboundCycleGroup struct {
+	*resolveOutboundCycleMember
+	next adapter.Outbound
+}
+
+func (g *resolveOutboundCycleGroup) All() []string                            { return []string{g.next.Tag()} }
+func (g *resolveOutboundCycleGroup) Selected(network string) adapter.Outbound { return g.next }
+func (g *resolveOutboundCycleGroup) AttachConnection(closer io.Closer) func() { return func() {} }
+
+func newResolveOutboundCycleGroup(tag string, next adapter.Outbound) *resolveOutboundCycleGroup {
+	return &resolveOutboundCycleGroup{
+		resolveOutboundCycleMember: &resolveOutboundCycleMember{
+			Adapter: outbound.NewAdapter(C.TypeSelector, tag, []string{N.NetworkTCP, N.NetworkUDP}, nil),
+		},
+		next: next,
+	}
+}
+
+// TestResolveOutboundCycleTerminates pins the depth guard on resolveOutbound.
+// Without it a cyclic group configuration (A selects B, B selects A) appends
+// one element to the chain per hop with no bound, so the function never returns
+// and the chain grows until the process runs out of memory. The pre-match walk
+// in route.Router.selectPreMatchOutbound bounds the same kind of traversal with
+// `depth > 8`; resolveOutbound had no bound at all.
+func TestResolveOutboundCycleTerminates(t *testing.T) {
+	var a, b *resolveOutboundCycleGroup
+	b = newResolveOutboundCycleGroup("b", nil)
+	a = newResolveOutboundCycleGroup("a", b)
+	b.next = a
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = resolveOutbound(a, N.NetworkTCP, &adapter.InboundContext{})
+	}()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("resolveOutbound did not terminate within 3s on a group cycle (a -> b -> a)")
+	}
+}
+
+// TestResolveOutboundSelfCycleTerminates covers the degenerate one-node cycle: a
+// group whose Selected() is itself.
+func TestResolveOutboundSelfCycleTerminates(t *testing.T) {
+	a := newResolveOutboundCycleGroup("a", nil)
+	a.next = a
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = resolveOutbound(a, N.NetworkTCP, &adapter.InboundContext{})
+	}()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("resolveOutbound did not terminate within 3s on a self cycle (a -> a)")
+	}
+}
