+package group
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// realtagCycleMember satisfies adapter.Outbound. Only Tag() and Network() are
+// reached by the RealTag walk; the dial methods exist to complete the interface.
+type realtagCycleMember struct {
+	outbound.Adapter
+}
+
+func (m *realtagCycleMember) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return nil, E.New("not implemented")
+}
+
+func (m *realtagCycleMember) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, E.New("not implemented")
+}
+
+// realtagCycleGroup is a minimal adapter.OutboundGroup whose Selected() points
+// at another group, so two of them form a cycle.
+type realtagCycleGroup struct {
+	*realtagCycleMember
+	next adapter.Outbound
+}
+
+func (g *realtagCycleGroup) All() []string                            { return []string{g.next.Tag()} }
+func (g *realtagCycleGroup) Selected(network string) adapter.Outbound { return g.next }
+func (g *realtagCycleGroup) AttachConnection(closer io.Closer) func() { return func() {} }
+
+func newRealtagCycleGroup(tag string, next adapter.Outbound) *realtagCycleGroup {
+	return &realtagCycleGroup{
+		realtagCycleMember: &realtagCycleMember{
+			Adapter: outbound.NewAdapter(C.TypeSelector, tag, []string{N.NetworkTCP, N.NetworkUDP}, nil),
+		},
+		next: next,
+	}
+}
+
+// TestRealTagCycleTerminates pins the depth guard on RealTag. Without it a
+// cyclic group configuration (A selects B, B selects A) makes the walk loop
+// forever: the caller goroutine never returns and spins at 100% CPU. The
+// pre-match walk in route.Router.selectPreMatchOutbound bounds the same kind of
+// traversal with `depth > 8`; RealTag had no bound at all.
+func TestRealTagCycleTerminates(t *testing.T) {
+	var a, b *realtagCycleGroup
+	b = newRealtagCycleGroup("b", nil)
+	a = newRealtagCycleGroup("a", b)
+	b.next = a
+
+	done := make(chan string, 1)
+	go func() {
+		done <- RealTag(a, N.NetworkTCP)
+	}()
+	select {
+	case got := <-done:
+		t.Logf("RealTag returned %q", got)
+	case <-time.After(3 * time.Second):
+		t.Fatal("RealTag did not terminate within 3s on a group cycle (a -> b -> a)")
+	}
+}
+
+// TestRealTagSelfCycleTerminates covers the degenerate one-node cycle: a group
+// whose Selected() is itself.
+func TestRealTagSelfCycleTerminates(t *testing.T) {
+	a := newRealtagCycleGroup("a", nil)
+	a.next = a
+
+	done := make(chan string, 1)
+	go func() {
+		done <- RealTag(a, N.NetworkTCP)
+	}()
+	select {
+	case got := <-done:
+		t.Logf("RealTag returned %q", got)
+	case <-time.After(3 * time.Second):
+		t.Fatal("RealTag did not terminate within 3s on a self cycle (a -> a)")
+	}
+}
