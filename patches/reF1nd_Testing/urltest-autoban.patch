+package group
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"math"
+	"math/rand"
+	"net"
+	"net/http"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/common/control"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/filemanager"
+)
+
+// AutoBan v3: sliding-window health scoring + passive circuit breaker + active
+// exponential-backoff recovery.
+//
+// Differences from v2:
+//   - No longer depends on fixed check_times for life/death decisions.
+//   - Each node has an EWMA health score (0..100) that combines success/failure
+//     and latency. A single success no longer fully resets the history.
+//   - A single failure still immediately makes the node Striked (circuit
+//     breaker). Repeated failures push the score down; when the score is below
+//     BanThreshold, or ConsecutiveFails reaches FailThreshold, the node is
+//     treated as banned.
+//   - Banned/striked nodes are actively re-probed with exponential backoff and
+//     randomized jitter, so recovery does not depend on user traffic.
+//   - Pre-flight network probe uses multiple 204 endpoints (domestic first for
+//     China direct connections) and races them.
+//   - State is keyed by a normalized tag so simple subscription renames such as
+//     "HK-01" -> "HK-01 | 1.5x" do not orphan the health record.
+type AutoBan struct {
+	access sync.RWMutex
+	ctx    context.Context
+
+	nodes     map[string]*nodeState
+	threshold int // hard consecutive-failure threshold
+	path      string
+
+	allTagsFunc func() []string
+	testFunc    func(ctx context.Context, tag string) (uint16, bool, bool)
+	onBan       func(tag string)
+	onUnban     func(tag string)
+	logger      log.Logger
+
+	checking atomic.Bool
+
+	closed    chan struct{}
+	startOnce sync.Once
+	closeOnce sync.Once
+
+	// Direct network pre-flight probe
+	probeURLs      []string
+	probeTimeout   time.Duration
+	probeInterval  time.Duration
+	httpClient     *http.Client
+	healthMu       sync.Mutex
+	healthOK       bool
+	healthChecked  time.Time
+
+	// Active recovery loop
+	recoveryInterval time.Duration
+	initialBackoff   time.Duration
+	maxBackoff       time.Duration
+
+	// Health scoring
+	banThreshold     float64
+	recoverThreshold float64
+	maxLatencyMs     float64
+	decayHalfLife    time.Duration
+	staleTTL         time.Duration
+	batchMode         int
+	recoverSuccesses  int
+	flushDelay        time.Duration
+	dirty             bool
+	flushTimer        *time.Timer
+	stopped           bool
+}
+
+type nodeState struct {
+	Key                 string    `json:"key"`
+	Tag                 string    `json:"tag,omitempty"`
+	Score               float64   `json:"score"`
+	Banned              bool      `json:"banned"`
+	LastFailAt          time.Time `json:"last_fail_at,omitempty"`
+	LastSuccessAt       time.Time `json:"last_success_at,omitempty"`
+	LastUpdate          time.Time `json:"last_update,omitempty"`
+	LastDecay           time.Time `json:"last_decay,omitempty"`
+	LastProbeAt         time.Time `json:"last_probe_at,omitempty"`
+	NextProbeAt         time.Time `json:"next_probe_at,omitempty"`
+	ConsecutiveFails    int       `json:"consecutive_fails"`
+	ConsecutiveSuccesses int      `json:"consecutive_successes"`
+	Backoff             time.Duration `json:"backoff,omitempty"`
+}
+
+// AutoBanOptions is the constructor input for AutoBan v3.
+type AutoBanOptions struct {
+	Threshold         int
+	Times             []time.Time // deprecated, kept for config compatibility
+	Cooldown          time.Duration // deprecated
+	Path              string
+	ProbeURLs         []string
+	ProbeTimeout      time.Duration
+	RecoveryInterval  time.Duration
+	InitialBackoff    time.Duration
+	MaxBackoff        time.Duration
+	BanThreshold      int
+	RecoverThreshold  int
+	MaxLatency        time.Duration
+	RecoverSuccesses  int
+	FlushDelay        time.Duration
+}
+
+// AutoBanNodeStatus is a stable snapshot for upper-layer UI / dashboard display.
+type AutoBanNodeStatus struct {
+	Tag                 string    `json:"tag"`
+	Key                 string    `json:"key"`
+	Banned              bool      `json:"banned"`
+	Striked             bool      `json:"striked"`
+	Score               float64   `json:"score"`
+	ConsecutiveFails    int       `json:"consecutive_fails"`
+	ConsecutiveSuccesses int      `json:"consecutive_successes"`
+	LastFail            time.Time `json:"last_fail,omitempty"`
+	LastSuccess         time.Time `json:"last_success,omitempty"`
+	NextProbe           time.Time `json:"next_probe,omitempty"`
+}
+
+const (
+	defaultAutoBanFailThreshold     = 5
+	defaultAutoBanProbeTimeout      = 5 * time.Second
+	defaultAutoBanProbeInterval     = 30 * time.Second
+	defaultAutoBanRecoveryInterval  = 1 * time.Minute
+	defaultAutoBanInitialBackoff    = 1 * time.Minute
+	defaultAutoBanMaxBackoff        = 30 * time.Minute
+	defaultAutoBanBanThreshold      = 25.0
+	defaultAutoBanRecoverThreshold  = 60.0
+	defaultAutoBanMaxLatency        = 1000 * time.Millisecond
+	defaultAutoBanDecayHalfLife     = 24 * time.Hour
+	defaultAutoBanStaleTTL          = 7 * 24 * time.Hour
+	defaultAutoBanRecoverSuccesses   = 2
+	defaultAutoBanFlushDelay         = 3 * time.Second
+	defaultAutoBanNeutralScore      = 80.0
+	defaultAutoBanInitialScore      = 100.0
+	defaultAutoBanSuccessAlpha      = 0.3
+	defaultAutoBanFailureAlpha      = 0.4
+)
+
+var defaultAutoBanProbeURLs = []string{
+	// 国内厂商/运营商高可用 204 探针，直连友好
+	"http://connect.rom.miui.com/generate_204",
+	"http://connectivitycheck.platform.hicloud.com/generate_204",
+	// 国际通用 204 探针
+	"http://cp.cloudflare.com/generate_204",
+	"http://www.gstatic.com/generate_204",
+	"http://connectivitycheck.gstatic.com/generate_204",
+}
+
+func NewAutoBan(ctx context.Context, options AutoBanOptions) *AutoBan {
+	if options.Threshold <= 0 {
+		options.Threshold = defaultAutoBanFailThreshold
+	}
+	if options.ProbeTimeout <= 0 {
+		options.ProbeTimeout = defaultAutoBanProbeTimeout
+	}
+	if options.RecoveryInterval <= 0 {
+		options.RecoveryInterval = defaultAutoBanRecoveryInterval
+	}
+	if options.InitialBackoff <= 0 {
+		options.InitialBackoff = defaultAutoBanInitialBackoff
+	}
+	if options.MaxBackoff <= 0 {
+		options.MaxBackoff = defaultAutoBanMaxBackoff
+	}
+	if options.MaxBackoff < options.InitialBackoff {
+		options.MaxBackoff = options.InitialBackoff
+	}
+	banThreshold := float64(options.BanThreshold)
+	if banThreshold <= 0 {
+		banThreshold = defaultAutoBanBanThreshold
+	}
+	recoverThreshold := float64(options.RecoverThreshold)
+	if recoverThreshold <= 0 {
+		recoverThreshold = defaultAutoBanRecoverThreshold
+	}
+	if recoverThreshold <= banThreshold {
+		recoverThreshold = banThreshold + 20
+	}
+	recoverSuccesses := options.RecoverSuccesses
+	if recoverSuccesses <= 0 {
+		recoverSuccesses = defaultAutoBanRecoverSuccesses
+	}
+	flushDelay := options.FlushDelay
+	if flushDelay <= 0 {
+		flushDelay = defaultAutoBanFlushDelay
+	}
+	maxLatency := options.MaxLatency
+	if maxLatency <= 0 {
+		maxLatency = defaultAutoBanMaxLatency
+	}
+	probeURLs := append([]string(nil), options.ProbeURLs...)
+	if len(probeURLs) == 0 {
+		probeURLs = append(probeURLs, defaultAutoBanProbeURLs...)
+	}
+	return &AutoBan{
+		ctx:              ctx,
+		nodes:            make(map[string]*nodeState),
+		threshold:        options.Threshold,
+		path:             options.Path,
+		probeURLs:        probeURLs,
+		probeTimeout:     options.ProbeTimeout,
+		probeInterval:    defaultAutoBanProbeInterval,
+		recoveryInterval: options.RecoveryInterval,
+		initialBackoff:   options.InitialBackoff,
+		maxBackoff:       options.MaxBackoff,
+		banThreshold:     banThreshold,
+		recoverThreshold: recoverThreshold,
+		maxLatencyMs:     float64(maxLatency.Milliseconds()),
+		decayHalfLife:    defaultAutoBanDecayHalfLife,
+		staleTTL:         defaultAutoBanStaleTTL,
+		closed:            make(chan struct{}),
+		recoverSuccesses:  recoverSuccesses,
+		flushDelay:        flushDelay,
+		httpClient:        newProtectedHTTPClient(ctx, options.ProbeTimeout),
+	}
+}
+
+// newProtectedHTTPClient builds an HTTP client whose dialer is protected by the
+// platform NetworkManager. On Android this calls through to VpnService.protect(),
+// so pre-flight probes bypass the TUN virtual interface and reach the physical
+// network directly.
+func newProtectedHTTPClient(ctx context.Context, timeout time.Duration) *http.Client {
+	dialer := &net.Dialer{
+		Timeout:   timeout,
+		KeepAlive: 30 * time.Second,
+	}
+	if networkManager := service.FromContext[adapter.NetworkManager](ctx); networkManager != nil {
+		if protectFunc := networkManager.ProtectFunc(); protectFunc != nil {
+			dialer.Control = control.Append(dialer.Control, protectFunc)
+		}
+	}
+	return &http.Client{
+		Timeout: timeout,
+		Transport: &http.Transport{
+			DialContext:       dialer.DialContext,
+			DisableKeepAlives: true,
+		},
+	}
+}
+
+// Start launches the active recovery loop. It is idempotent.
+func (a *AutoBan) Start() {
+	a.startOnce.Do(func() {
+		go a.recoveryLoop()
+	})
+}
+
+// Close stops the active recovery loop and flushes any pending state.
+// It is idempotent and safe for concurrent callers.
+func (a *AutoBan) Close() {
+	a.closeOnce.Do(func() {
+		close(a.closed)
+		a.access.Lock()
+		a.stopped = true
+		if a.flushTimer != nil {
+			a.flushTimer.Stop()
+			a.flushTimer = nil
+		}
+		if a.dirty {
+			a.dirty = false
+			a.writeStateLocked()
+		}
+		a.access.Unlock()
+	})
+}
+
+// normalizeTagKey returns a stable state key for a subscription tag.
+// It only performs safe normalization: trim, lowercase, collapse whitespace
+// and drop control characters. It deliberately does NOT merge different
+// multiplier lines such as "HK-01 | 0.5x" and "HK-01 | 2.0x", because those
+// are separate physical servers in most subscription providers.
+func normalizeTagKey(tag string) string {
+	s := strings.ToLower(strings.TrimSpace(tag))
+	var b strings.Builder
+	for _, r := range s {
+		if r < 0x20 || r == 0x7f {
+			continue
+		}
+		b.WriteRune(r)
+	}
+	return strings.Join(strings.Fields(b.String()), " ")
+}
+
+func (a *AutoBan) keyOf(tag string) string {
+	return normalizeTagKey(tag)
+}
+
+func (a *AutoBan) getOrCreateLocked(tag string) *nodeState {
+	key := a.keyOf(tag)
+	n := a.nodes[key]
+	if n == nil {
+		n = &nodeState{
+			Key:   key,
+			Tag:   tag,
+			Score: defaultAutoBanInitialScore,
+		}
+		a.nodes[key] = n
+	}
+	if n.Tag != tag {
+		n.Tag = tag // keep last-seen display tag
+	}
+	return n
+}
+
+func (a *AutoBan) getLocked(tag string) *nodeState {
+	return a.nodes[a.keyOf(tag)]
+}
+
+func (a *AutoBan) inFailureLocked(n *nodeState) bool {
+	return n.ConsecutiveFails > 0 || (!n.LastFailAt.IsZero() && !n.LastSuccessAt.After(n.LastFailAt))
+}
+
+// decayLocked applies time-based mean reversion toward the neutral score.
+// This prevents one old bad day from permanently killing a node. Nodes that are
+// still in a failure state are capped below banThreshold so time alone cannot
+// resurrect a dead node; a real successful probe is required.
+func (a *AutoBan) decayLocked(n *nodeState, now time.Time) {
+	if n.LastDecay.IsZero() {
+		n.LastDecay = now
+		return
+	}
+	dt := now.Sub(n.LastDecay)
+	if dt <= 0 {
+		return
+	}
+	factor := math.Exp(-float64(dt) / float64(a.decayHalfLife))
+	n.Score = defaultAutoBanNeutralScore + (n.Score-defaultAutoBanNeutralScore)*factor
+	if n.Score < 0 {
+		n.Score = 0
+	}
+	if n.Score > 100 {
+		n.Score = 100
+	}
+	if a.inFailureLocked(n) && a.banThreshold > 1 && n.Score > a.banThreshold-1 {
+		n.Score = a.banThreshold - 1
+	}
+	n.LastDecay = now
+}
+
+func (a *AutoBan) quality(delay uint16) float64 {
+	if delay == 0 {
+		return 1
+	}
+	if a.maxLatencyMs <= 0 {
+		return 1
+	}
+	q := 1 - float64(delay)/a.maxLatencyMs
+	if q < 0 {
+		q = 0
+	}
+	return q
+}
+
+func (a *AutoBan) bannedLocked(n *nodeState, now time.Time) bool {
+	a.decayLocked(n, now)
+	if n.Banned {
+		// Already in banned state: require real recovery (score above
+		// recoverThreshold and several consecutive successes) before clearing.
+		if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+			return true
+		}
+		if n.Score < a.recoverThreshold {
+			return true
+		}
+		if n.ConsecutiveSuccesses < a.recoverSuccesses {
+			return true
+		}
+		n.Banned = false
+		return false
+	}
+	// Enter banned state only when the node is truly bad, not merely Striked.
+	if n.ConsecutiveFails >= a.threshold || n.Score < a.banThreshold {
+		n.Banned = true
+		return true
+	}
+	return false
+}
+
+func (a *AutoBan) strikedLocked(n *nodeState) bool {
+	if n.ConsecutiveFails > 0 {
+		return true
+	}
+	if !n.LastFailAt.IsZero() && !n.LastSuccessAt.After(n.LastFailAt) {
+		return true
+	}
+	// Hysteresis: a single lucky success after a failure is not enough to
+	// immediately route traffic back. Require a few consecutive successes.
+	if !n.LastFailAt.IsZero() && n.ConsecutiveSuccesses < a.recoverSuccesses {
+		return true
+	}
+	return false
+}
+
+func (a *AutoBan) blockedLocked(n *nodeState, now time.Time) bool {
+	return a.bannedLocked(n, now) || a.strikedLocked(n)
+}
+
+// RecordResult feeds a passive probe result (regular interval or manual test).
+// ok=false is ignored when the direct network probe says the local network is
+// down, avoiding mass environmental misattribution.
+func (a *AutoBan) RecordResult(tag string, delay uint16, ok bool) {
+	if !ok && !a.isNetworkHealthy() {
+		return
+	}
+	now := time.Now()
+	var banCb, unbanCb func(string)
+	a.access.Lock()
+	banCb, unbanCb = a.recordResultLocked(tag, delay, ok, now)
+	a.access.Unlock()
+	if banCb != nil {
+		banCb(tag)
+	}
+	if unbanCb != nil {
+		unbanCb(tag)
+	}
+}
+
+func (a *AutoBan) recordResultLocked(tag string, delay uint16, ok bool, now time.Time) (banCb func(string), unbanCb func(string)) {
+	n := a.getOrCreateLocked(tag)
+	wasBanned := a.bannedLocked(n, now)
+	wasStriked := a.strikedLocked(n)
+
+	if ok {
+		q := a.quality(delay)
+		target := q * 100
+		n.Score += defaultAutoBanSuccessAlpha * (target - n.Score)
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		if n.Score > 100 {
+			n.Score = 100
+		}
+		n.LastSuccessAt = now
+		n.LastProbeAt = now
+		n.ConsecutiveFails = 0
+		n.ConsecutiveSuccesses++
+		n.Backoff = 0
+		n.NextProbeAt = time.Time{}
+	} else {
+		n.ConsecutiveFails++
+		penalty := defaultAutoBanFailureAlpha * (1 + 0.25*float64(n.ConsecutiveFails-1))
+		if penalty > 1 {
+			penalty = 1
+		}
+		n.Score -= penalty * n.Score
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		n.LastFailAt = now
+		n.LastProbeAt = now
+		n.ConsecutiveSuccesses = 0
+		if n.Backoff <= 0 {
+			n.Backoff = a.initialBackoff
+		} else {
+			n.Backoff *= 2
+			if n.Backoff > a.maxBackoff {
+				n.Backoff = a.maxBackoff
+			}
+		}
+		n.NextProbeAt = now.Add(n.Backoff + jitterDuration(n.Backoff))
+	}
+	n.LastUpdate = now
+	n.LastDecay = now
+
+	nowBanned := a.bannedLocked(n, now)
+	nowStriked := a.strikedLocked(n)
+	if !wasBanned && nowBanned && a.onBan != nil {
+		banCb = a.onBan
+	}
+	if wasBanned && !nowBanned && a.onUnban != nil {
+		unbanCb = a.onUnban
+	}
+	if !wasBanned && wasStriked && !nowStriked && a.onUnban != nil {
+		unbanCb = a.onUnban
+	}
+	a.saveLocked()
+	return
+}
+
+// IsBanned reports whether the node is currently treated as permanently banned.
+func (a *AutoBan) IsBanned(tag string) bool {
+	now := time.Now()
+	a.access.Lock()
+	defer a.access.Unlock()
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	return a.bannedLocked(n, now)
+}
+
+// Striked reports whether the node is currently in the temporary circuit-break state.
+func (a *AutoBan) Striked(tag string) bool {
+	a.access.Lock()
+	defer a.access.Unlock()
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	a.decayLocked(n, time.Now())
+	return a.strikedLocked(n)
+}
+
+// Blocked is the combined predicate used by Select(): banned or currently struck.
+func (a *AutoBan) Blocked(tag string) bool {
+	now := time.Now()
+	a.access.Lock()
+	defer a.access.Unlock()
+	n := a.getLocked(tag)
+	if n == nil {
+		return false
+	}
+	return a.blockedLocked(n, now)
+}
+
+// Snapshot returns a stable, sorted view of tracked node states for UI.
+func (a *AutoBan) Snapshot() []AutoBanNodeStatus {
+	now := time.Now()
+	a.access.Lock()
+	defer a.access.Unlock()
+
+	currentTagByKey := make(map[string]string)
+	if a.allTagsFunc != nil {
+		for _, tag := range a.allTagsFunc() {
+			currentTagByKey[a.keyOf(tag)] = tag
+		}
+	}
+	statuses := make([]AutoBanNodeStatus, 0, len(a.nodes))
+	for key, n := range a.nodes {
+		a.decayLocked(n, now)
+		tag := currentTagByKey[key]
+		if tag == "" {
+			tag = n.Tag
+		}
+		statuses = append(statuses, AutoBanNodeStatus{
+			Tag:                  tag,
+			Key:                  key,
+			Banned:               a.bannedLocked(n, now),
+			Striked:              a.strikedLocked(n),
+			Score:                n.Score,
+			ConsecutiveFails:     n.ConsecutiveFails,
+			ConsecutiveSuccesses: n.ConsecutiveSuccesses,
+			LastFail:             n.LastFailAt,
+			LastSuccess:          n.LastSuccessAt,
+			NextProbe:            n.NextProbeAt,
+		})
+	}
+	sort.Slice(statuses, func(i, j int) bool {
+		return statuses[i].Key < statuses[j].Key
+	})
+	return statuses
+}
+
+// recoveryLoop actively probes unhealthy nodes with exponential backoff and jitter.
+// This is the replacement for the old fixed check_times scheduler.
+func (a *AutoBan) recoveryLoop() {
+	// Initial short randomized delay avoids a thundering herd on startup.
+	select {
+	case <-a.closed:
+		return
+	case <-time.After(jitterDuration(a.recoveryInterval)):
+	}
+	for {
+		a.runRecoveryRound()
+		select {
+		case <-a.closed:
+			return
+		case <-time.After(a.recoveryInterval + jitterDuration(a.recoveryInterval)):
+		}
+	}
+}
+
+func (a *AutoBan) runRecoveryRound() {
+	if a.testFunc == nil || a.allTagsFunc == nil {
+		return
+	}
+	if !a.checking.CompareAndSwap(false, true) {
+		return
+	}
+	defer a.checking.Store(false)
+
+	if !a.isNetworkHealthy() {
+		return
+	}
+
+	tags := a.allTagsFunc()
+	now := time.Now()
+
+	type probeTask struct {
+		tag string
+	}
+	var tasks []probeTask
+
+	a.access.Lock()
+	currentKeys := make(map[string]bool, len(tags))
+	for _, tag := range tags {
+		key := a.keyOf(tag)
+		currentKeys[key] = true
+		n := a.getOrCreateLocked(tag)
+		a.decayLocked(n, now)
+		// Only actively probe nodes that are blocked or already have a health
+		// history below the recovery threshold. Brand-new neutral nodes are left
+		// to the regular URLTest interval to avoid scanning the whole list every
+		// minute.
+		if a.blockedLocked(n, now) || (!n.LastProbeAt.IsZero() && n.Score < a.recoverThreshold) {
+			if n.NextProbeAt.IsZero() || !n.NextProbeAt.After(now) {
+				tasks = append(tasks, probeTask{tag: tag})
+			}
+		}
+	}
+	// GC stale state for removed subscription tags.
+	staleTTL := a.staleTTL
+	if staleTTL <= 0 {
+		staleTTL = defaultAutoBanStaleTTL
+	}
+	for key, n := range a.nodes {
+		if !currentKeys[key] && !n.LastUpdate.IsZero() && now.Sub(n.LastUpdate) > staleTTL {
+			delete(a.nodes, key)
+		}
+	}
+	a.access.Unlock()
+
+	a.access.Lock()
+	a.batchMode++
+	a.access.Unlock()
+	defer func() {
+		a.access.Lock()
+		a.batchMode--
+		if a.batchMode == 0 && a.dirty {
+			a.saveLocked()
+		}
+		a.access.Unlock()
+	}()
+
+	// Probe with an adaptive worker pool. Serial probing would let a few 5s
+	// timeouts block the whole recovery round for minutes; a fixed pool of 4 is
+	// too slow for 200+ node subscriptions. Scale from 4 to 12 workers based on
+	// the number of unhealthy nodes, while keeping a ceiling to avoid a
+	// thundering herd / mobile CPU spike.
+	const (
+		minRecoveryWorkers = 4
+		maxRecoveryWorkers = 12
+	)
+	workerCount := minRecoveryWorkers
+	if len(tasks) > 20 {
+		workerCount = 6
+	}
+	if len(tasks) > 60 {
+		workerCount = 8
+	}
+	if len(tasks) > 120 {
+		workerCount = maxRecoveryWorkers
+	}
+	if workerCount > len(tasks) {
+		workerCount = len(tasks)
+	}
+	if workerCount <= 0 {
+		return
+	}
+	taskCh := make(chan probeTask)
+	var wg sync.WaitGroup
+	for i := 0; i < workerCount; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for task := range taskCh {
+				delay, ok, exists := a.testFunc(a.ctx, task.tag)
+				if !exists {
+					continue
+				}
+				var banCb, unbanCb func(string)
+				a.access.Lock()
+				banCb, unbanCb = a.recordResultLocked(task.tag, delay, ok, time.Now())
+				a.access.Unlock()
+				if banCb != nil {
+					banCb(task.tag)
+				}
+				if unbanCb != nil {
+					unbanCb(task.tag)
+				}
+			}
+		}()
+	}
+	go func() {
+		defer close(taskCh)
+		for _, task := range tasks {
+			select {
+			case <-a.closed:
+				return
+			case taskCh <- task:
+			}
+		}
+	}()
+	wg.Wait()
+}
+
+type autoBanStateV3 struct {
+	Nodes     map[string]*nodeState `json:"nodes"`
+	LastCheck time.Time             `json:"last_check"`
+}
+
+// legacyAutoBanState is the v2 file format, used only for migration.
+type legacyAutoBanState struct {
+	Banned     []string             `json:"banned"`
+	Strikes    map[string]int       `json:"strikes"`
+	LastFail   map[string]time.Time `json:"last_fail"`
+	LastStrike map[string]time.Time `json:"last_strike"`
+	LastCheck  time.Time            `json:"last_check"`
+}
+
+// Load restores state from the persistent JSON file and migrates v2 files.
+func (a *AutoBan) Load() error {
+	if a.path == "" {
+		return nil
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+
+	path := filemanager.BasePath(a.ctx, a.path)
+	content, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return E.Cause(err, "read autoban state")
+	}
+
+	var state autoBanStateV3
+	if err := json.Unmarshal(content, &state); err == nil && len(state.Nodes) > 0 {
+		a.nodes = state.Nodes
+		if a.nodes == nil {
+			a.nodes = make(map[string]*nodeState)
+		}
+		return nil
+	}
+
+	// Try legacy v2 format.
+	var legacy legacyAutoBanState
+	if err := json.Unmarshal(content, &legacy); err != nil {
+		// Corrupted file (e.g. power loss during write): do not block startup.
+		// Reset to a clean state and let active probes rebuild the health data.
+		if a.logger != nil {
+			a.logger.Warn("auto_ban: corrupted state file, resetting: ", err)
+		}
+		a.nodes = make(map[string]*nodeState)
+		return nil
+	}
+	a.nodes = make(map[string]*nodeState)
+	now := time.Now()
+	for _, tag := range legacy.Banned {
+		key := a.keyOf(tag)
+		n := &nodeState{
+			Key:              key,
+			Tag:              tag,
+			Score:            0,
+			Banned:           true,
+			LastFailAt:       legacy.LastFail[tag],
+			LastUpdate:       now,
+			LastDecay:        now,
+			ConsecutiveFails: a.threshold,
+		}
+		a.nodes[key] = n
+	}
+	for tag, strikes := range legacy.Strikes {
+		key := a.keyOf(tag)
+		n := a.nodes[key]
+		if n == nil {
+			n = &nodeState{Key: key, Tag: tag, LastUpdate: now, LastDecay: now}
+			a.nodes[key] = n
+		}
+		n.Score = defaultAutoBanNeutralScore - float64(strikes)*10
+		if n.Score < 0 {
+			n.Score = 0
+		}
+		if failAt, ok := legacy.LastFail[tag]; ok {
+			n.LastFailAt = failAt
+		}
+		n.ConsecutiveFails = strikes
+	}
+	return nil
+}
+
+// saveLocked marks state dirty and schedules a debounced asynchronous flush.
+// Caller must hold a.access. This prevents UFS/JSON write spam on mobile.
+func (a *AutoBan) saveLocked() {
+	if a.path == "" || a.stopped {
+		return
+	}
+	a.dirty = true
+	if a.batchMode > 0 {
+		return
+	}
+	if a.flushTimer == nil {
+		a.flushTimer = time.AfterFunc(a.flushDelay, a.flush)
+	}
+}
+
+// flush is the debounced disk writer. It is safe to call from the timer
+// callback or from Close().
+func (a *AutoBan) flush() {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.flushTimer != nil {
+		a.flushTimer.Stop()
+		a.flushTimer = nil
+	}
+	if !a.dirty {
+		return
+	}
+	a.dirty = false
+	a.writeStateLocked()
+}
+
+// writeStateLocked performs the actual JSON serialization and file write.
+// Caller must hold a.access.
+func (a *AutoBan) writeStateLocked() {
+	state := autoBanStateV3{
+		Nodes:     a.nodes,
+		LastCheck: time.Now(),
+	}
+	content, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return
+	}
+	path := filemanager.BasePath(a.ctx, a.path)
+	_ = filemanager.WriteFile(a.ctx, path, content, 0o644)
+}
+
+// isNetworkHealthy runs/caches a multi-target direct pre-flight probe.
+func (a *AutoBan) isNetworkHealthy() bool {
+	if len(a.probeURLs) == 0 {
+		return true
+	}
+	off := false
+	for _, u := range a.probeURLs {
+		if strings.EqualFold(u, "off") || strings.EqualFold(u, "none") {
+			off = true
+			break
+		}
+	}
+	if off {
+		return true
+	}
+
+	a.healthMu.Lock()
+	defer a.healthMu.Unlock()
+
+	if !a.healthChecked.IsZero() && time.Since(a.healthChecked) < a.probeInterval {
+		return a.healthOK
+	}
+
+	ok := a.probeNetwork()
+	changed := a.healthChecked.IsZero() || a.healthOK != ok
+	a.healthChecked = time.Now()
+	a.healthOK = ok
+	if changed && a.logger != nil {
+		if ok {
+			a.logger.Info("auto_ban: direct network probe ok")
+		} else {
+			a.logger.Warn("auto_ban: all direct network probes failed; skip failure accounting")
+		}
+	}
+	return ok
+}
+
+// probeNetwork races multiple 204 endpoints. Any 2xx response means the local
+// network is considered healthy.
+func (a *AutoBan) probeNetwork() bool {
+	ctx, cancel := context.WithTimeout(a.ctx, a.probeTimeout)
+	defer cancel()
+	results := make(chan bool, len(a.probeURLs))
+	for _, url := range a.probeURLs {
+		go func(u string) {
+			results <- a.probeOne(ctx, u)
+		}(url)
+	}
+	for range a.probeURLs {
+		if <-results {
+			return true
+		}
+	}
+	return false
+}
+
+func (a *AutoBan) probeOne(ctx context.Context, url string) bool {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return false
+	}
+	resp, err := a.httpClient.Do(req)
+	if err != nil {
+		return false
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 512))
+	return resp.StatusCode >= 200 && resp.StatusCode < 300
+}
+
+func jitterDuration(d time.Duration) time.Duration {
+	if d <= 0 {
+		return 0
+	}
+	maxJitter := d / 5
+	if maxJitter <= 0 {
+		maxJitter = time.Millisecond
+	}
+	return time.Duration(rand.Int63n(int64(maxJitter)))
+}
