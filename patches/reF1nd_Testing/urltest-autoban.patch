diff --git a/protocol/group/autoban.go b/protocol/group/autoban.go
new file mode 100644
index 0000000..e666b79
--- /dev/null
+++ b/protocol/group/autoban.go
@@ -0,0 +1,308 @@
+package group
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"sort"
+	"sync"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service/filemanager"
+)
+
+// AutoBan 实现基于多时段定时探测的节点淘汰与恢复：
+//   - 每天在设定的多个时刻（check_times，本地时区 "HH:MM"）各做一轮全量 urltest
+//   - 任一测试（定时/手动/常规 interval）失败的节点被暂时禁用（跳过选择，等价临时删除）
+//   - 之后任何一次测试成功即自动恢复
+//   - 连续 fail_threshold 个"失败时段"的节点被永久淘汰（banned）
+//   - 失败时段计数带冷却窗口（cooldown，默认 30m）：同节点窗口内多次失败只计 1 个时段，
+//     防止分钟级 interval 自动测试快速刷满阈值；窗口外的每次失败（含手动测试）都推进计数，
+//     因此用户在非设定时间主动测试同样具有淘汰效力
+//   - 淘汰状态持久化到 JSON 文件（跨重启保留；由 filemanager 解析到 SFA/libbox 工作目录）
+type AutoBan struct {
+	access sync.Mutex
+	ctx    context.Context
+	// 淘汰阈值：连续失败时段达到该数即永久淘汰
+	threshold int
+	// 每日检查时刻（本地时区，已排序）
+	times []time.Time
+	// 失败时段冷却窗口
+	cooldown time.Duration
+	// 状态：realTag -> 失败时段计数
+	strikes map[string]int
+	banned  map[string]bool
+	// realTag -> 上次计入失败时段的时间（冷却判定）
+	lastFailAt map[string]time.Time
+	lastCheck  time.Time
+	// 全量节点清单回调（定时任务首轮探测需要：strikes/banned 初始为空，
+	// 只遍历已知状态会漏掉从未失败过的节点）
+	allTagsFunc func() []string
+	// 持久化路径（空则不持久化）
+	path string
+	// 测试回调：由 URLTestGroup 注入，对单个出站做一次真实 urltest
+	testFunc func(ctx context.Context, tag string) (uint16, bool)
+	// 淘汰/恢复回调
+	onBan   func(tag string)
+	onUnban func(tag string)
+	checking bool
+	closed  chan struct{}
+}
+
+func NewAutoBan(ctx context.Context, threshold int, times []time.Time, cooldown time.Duration, path string) *AutoBan {
+	if threshold <= 0 {
+		threshold = 3
+	}
+	if cooldown <= 0 {
+		cooldown = 30 * time.Minute
+	}
+	sorted := append([]time.Time(nil), times...)
+	sort.Slice(sorted, func(i, j int) bool {
+		if sorted[i].Hour() != sorted[j].Hour() {
+			return sorted[i].Hour() < sorted[j].Hour()
+		}
+		return sorted[i].Minute() < sorted[j].Minute()
+	})
+	return &AutoBan{
+		ctx:        ctx,
+		threshold:  threshold,
+		times:      sorted,
+		cooldown:   cooldown,
+		strikes:    make(map[string]int),
+		banned:     make(map[string]bool),
+		lastFailAt: make(map[string]time.Time),
+		path:       path,
+		closed:     make(chan struct{}),
+	}
+}
+
+// Start 启动每日定时调度
+func (a *AutoBan) Start() {
+	if len(a.times) == 0 {
+		return
+	}
+	go a.loop()
+}
+
+func (a *AutoBan) Close() {
+	select {
+	case <-a.closed:
+	default:
+		close(a.closed)
+	}
+}
+
+func (a *AutoBan) loop() {
+	for {
+		next := a.nextCheckTime(time.Now())
+		timer := time.NewTimer(time.Until(next))
+		select {
+		case <-a.closed:
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+		a.runScheduledCheck()
+	}
+}
+
+// nextCheckTime 计算从 from 起下一个检查时刻（含今日未到时刻；times 已排序）
+func (a *AutoBan) nextCheckTime(from time.Time) time.Time {
+	best := time.Time{}
+	for _, daily := range a.times {
+		today := time.Date(from.Year(), from.Month(), from.Day(), daily.Hour(), daily.Minute(), 0, 0, from.Location())
+		if today.After(from) && (best.IsZero() || today.Before(best)) {
+			best = today
+		}
+	}
+	if !best.IsZero() {
+		return best
+	}
+	// 今日全部已过：取明日最早时刻（times[0] 已排序）
+	tomorrow := from.AddDate(0, 0, 1)
+	return time.Date(tomorrow.Year(), tomorrow.Month(), tomorrow.Day(), a.times[0].Hour(), a.times[0].Minute(), 0, 0, tomorrow.Location())
+}
+
+// runScheduledCheck 执行一轮全量测试并更新淘汰状态。
+// 节点清单 = 全量回调 + 状态表中的节点（含已 banned 的——继续探测保证恢复通道）。
+func (a *AutoBan) runScheduledCheck() {
+	if a.testFunc == nil {
+		return
+	}
+	a.access.Lock()
+	if a.checking {
+		a.access.Unlock()
+		return
+	}
+	a.checking = true
+	tagSet := make(map[string]bool)
+	if a.allTagsFunc != nil {
+		for _, tag := range a.allTagsFunc() {
+			tagSet[tag] = true
+		}
+	}
+	for tag := range a.banned {
+		tagSet[tag] = true
+	}
+	for tag := range a.strikes {
+		tagSet[tag] = true
+	}
+	tags := make([]string, 0, len(tagSet))
+	for tag := range tagSet {
+		tags = append(tags, tag)
+	}
+	sort.Strings(tags)
+	a.access.Unlock()
+
+	for _, tag := range tags {
+		select {
+		case <-a.closed:
+			return
+		default:
+		}
+		_, ok := a.testFunc(a.ctx, tag)
+		a.access.Lock()
+		if ok {
+			a.recoverLocked(tag)
+		} else {
+			a.recordFailLocked(tag, time.Now())
+		}
+		a.access.Unlock()
+	}
+	a.access.Lock()
+	a.lastCheck = time.Now()
+	a.saveLocked()
+	a.checking = false
+	a.access.Unlock()
+}
+
+// RecordResult 供 URLTestGroup 在常规 interval / 手动测试中同步结果：
+// 成功立即恢复；失败在冷却窗口外计入一个失败时段（手动测试因此具有淘汰效力）。
+func (a *AutoBan) RecordResult(tag string, ok bool) {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if ok {
+		a.recoverLocked(tag)
+		return
+	}
+	a.recordFailLocked(tag, time.Now())
+}
+
+// recoverLocked 成功路径：清零并恢复（需持锁）
+func (a *AutoBan) recoverLocked(tag string) {
+	if a.banned[tag] {
+		delete(a.banned, tag)
+		delete(a.strikes, tag)
+		delete(a.lastFailAt, tag)
+		if a.onUnban != nil {
+			a.onUnban(tag)
+		}
+		a.saveLocked()
+		return
+	}
+	if a.strikes[tag] > 0 {
+		delete(a.strikes, tag)
+		delete(a.lastFailAt, tag)
+		a.saveLocked()
+	}
+}
+
+// recordFailLocked 失败路径（需持锁）：冷却窗口外计入一个失败时段；
+// 窗口内仅刷新 lastFailAt（保持暂时禁用语义）
+func (a *AutoBan) recordFailLocked(tag string, now time.Time) {
+	last, seen := a.lastFailAt[tag]
+	if !seen || now.Sub(last) >= a.cooldown {
+		a.strikes[tag]++
+		if a.strikes[tag] >= a.threshold && !a.banned[tag] {
+			a.banned[tag] = true
+			if a.onBan != nil {
+				a.onBan(tag)
+			}
+		}
+	}
+	a.lastFailAt[tag] = now
+	a.saveLocked()
+}
+
+// IsBanned 节点是否被永久淘汰
+func (a *AutoBan) IsBanned(tag string) bool {
+	a.access.Lock()
+	defer a.access.Unlock()
+	return a.banned[tag]
+}
+
+// Striked 节点是否处于失败未恢复状态（暂时禁用中）
+func (a *AutoBan) Striked(tag string) bool {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.strikes[tag] > 0 {
+		return true
+	}
+	_, hasFail := a.lastFailAt[tag]
+	return hasFail
+}
+
+type autoBanState struct {
+	Banned    []string           `json:"banned"`
+	Strikes   map[string]int     `json:"strikes"`
+	LastFail  map[string]time.Time `json:"last_fail"`
+	LastCheck time.Time          `json:"last_check"`
+}
+
+// Load 从持久化文件恢复状态
+func (a *AutoBan) Load() error {
+	if a.path == "" {
+		return nil
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+	path := filemanager.BasePath(a.ctx, a.path)
+	content, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return E.Cause(err, "read autoban state")
+	}
+	var state autoBanState
+	if err := json.Unmarshal(content, &state); err != nil {
+		return E.Cause(err, "parse autoban state")
+	}
+	a.banned = make(map[string]bool, len(state.Banned))
+	for _, tag := range state.Banned {
+		a.banned[tag] = true
+	}
+	a.strikes = state.Strikes
+	if a.strikes == nil {
+		a.strikes = make(map[string]int)
+	}
+	a.lastFailAt = state.LastFail
+	if a.lastFailAt == nil {
+		a.lastFailAt = make(map[string]time.Time)
+	}
+	a.lastCheck = state.LastCheck
+	return nil
+}
+
+// saveLocked 持久化状态（需持锁调用）
+func (a *AutoBan) saveLocked() {
+	if a.path == "" {
+		return
+	}
+	state := autoBanState{
+		Banned:    make([]string, 0, len(a.banned)),
+		Strikes:   a.strikes,
+		LastFail:  a.lastFailAt,
+		LastCheck: a.lastCheck,
+	}
+	for tag := range a.banned {
+		state.Banned = append(state.Banned, tag)
+	}
+	content, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return
+	}
+	path := filemanager.BasePath(a.ctx, a.path)
+	_ = filemanager.WriteFile(a.ctx, path, content, 0o644)
+}
