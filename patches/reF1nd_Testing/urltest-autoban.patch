+// selectLastResort is the deadlock fallback. When every usable candidate has
+// been exhausted (all nodes are banned/striked or have no history), it returns
+// the best available node; if even that is impossible it returns a blocked node
+// with the lowest historical latency so the client can still attempt recovery.
+func (g *URLTestGroup) selectLastResort(network string) (adapter.Outbound, bool) {
+	var bestAvailable, bestBlocked adapter.Outbound
+	var bestAvailableDelay, bestBlockedDelay uint16
+	var hasAvailableDelay, hasBlockedDelay bool
+
+	for _, detour := range g.outbounds {
+		if !common.Contains(detour.Network(), network) {
+			continue
+		}
+		tag := RealTag(detour)
+		blocked := g.autoBan != nil && g.autoBan.Blocked(tag)
+		history := g.history.LoadURLTestHistory(tag)
+		if history != nil {
+			if !blocked {
+				if !hasAvailableDelay || history.Delay < bestAvailableDelay {
+					bestAvailable = detour
+					bestAvailableDelay = history.Delay
+					hasAvailableDelay = true
+				}
+			} else {
+				if !hasBlockedDelay || history.Delay < bestBlockedDelay {
+					bestBlocked = detour
+					bestBlockedDelay = history.Delay
+					hasBlockedDelay = true
+				}
+			}
+		} else {
+			if !blocked && bestAvailable == nil {
+				bestAvailable = detour
+			}
+			if blocked && bestBlocked == nil {
+				bestBlocked = detour
+			}
+		}
+	}
+	if bestAvailable != nil {
+		return bestAvailable, false
+	}
+	if bestBlocked != nil {
+		if g.autoBan != nil {
+			g.logger.Warn("auto_ban: no available outbound, last-resort fallback to blocked outbound ", bestBlocked.Tag())
+		}
+		return bestBlocked, false
+	}
+	return nil, false
+}
