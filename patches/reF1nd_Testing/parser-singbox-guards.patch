index 0000000..cec3d34
--- /dev/null
+++ b/provider/parser/singbox_shapes_test.go
@@ -0,0 +1,37 @@
+package parser
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Subscription content is untrusted remote input: provider/remote fetches it in
+// a background goroutine, so a panic here takes down the whole process.
+//
+// The box-subscription decoder walked the raw badjson values and type-asserted
+// them without checking: `outbounds.(badjson.JSONArray)`,
+// `outbound.(*badjson.JSONObject)` and `typeVal.(string)`. A malformed document
+// therefore panicked instead of returning an error.
+func TestParseBoxSubscriptionMalformedOutbounds(t *testing.T) {
+	for _, content := range []string{
+		`{"outbounds": 5}`,
+		`{"outbounds": "x"}`,
+		`{"outbounds": [1,2]}`,
+		`{"outbounds": ["a"]}`,
+		`{"outbounds": [null]}`,
+		`{"outbounds": {"a":1}}`,
+		`{"outbounds": [{"type": 5}]}`,
+		`{"outbounds": [{"type": ["a"]}]}`,
+		`{"outbounds": [{"type": null}]}`,
+		`{"outbounds": [{"type":"direct"}, 7]}`,
+	} {
+		t.Run(content, func(t *testing.T) {
+			require.NotPanics(t, func() {
+				_, _, err := ParseBoxSubscription(context.Background(), content)
+				require.Error(t, err)
+			})
+		})
+	}
+}
