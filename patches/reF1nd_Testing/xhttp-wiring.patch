+package option
+
+import (
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Range 是 XHTTP 移植的本地类型。
+// shtorm-7 通过私有 sing fork（badoption.Range）提供该类型，官方 sagernet/sing 没有；
+// 本地在 option 包内定义等价实现，避免 replace sing 依赖。
+type Integer interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 |
+		~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
+}
+
+type Range[T Integer] struct {
+	From T `json:"from"`
+	To   T `json:"to"`
+}
+
+func (c *Range[T]) MarshalJSON() ([]byte, error) {
+	if c.From == c.To {
+		return json.Marshal(c.From)
+	}
+	return json.Marshal(fmt.Sprintf("%d-%d", c.From, c.To))
+}
+
+func (c *Range[T]) UnmarshalJSON(content []byte) error {
+	var stringValue string
+	if err := json.Unmarshal(content, &stringValue); err == nil {
+		parts := strings.Split(stringValue, "-")
+		switch len(parts) {
+		case 1:
+			v, err := strconv.ParseInt(parts[0], 10, 64)
+			if err != nil {
+				return err
+			}
+			c.From, c.To = T(v), T(v)
+		case 2:
+			from, err := strconv.ParseInt(parts[0], 10, 64)
+			if err != nil {
+				return err
+			}
+			to, err := strconv.ParseInt(parts[1], 10, 64)
+			if err != nil {
+				return err
+			}
+			c.From, c.To = T(from), T(to)
+		default:
+			return E.New("invalid range: ", stringValue)
+		}
+	} else {
+		var single T
+		if err := json.Unmarshal(content, &single); err == nil {
+			c.From, c.To = single, single
+		} else {
+			type plain struct {
+				From T `json:"from"`
+				To   T `json:"to"`
+			}
+			var p plain
+			if err := json.Unmarshal(content, &p); err != nil {
+				return err
+			}
+			c.From, c.To = p.From, p.To
+		}
+	}
+	if c.From > c.To {
+		return E.New("invalid range")
+	}
+	return nil
+}
+
+func (c *Range[T]) String() string {
+	if c.From == c.To {
+		return fmt.Sprintf("%d", c.From)
+	}
+	return fmt.Sprintf("%d-%d", c.From, c.To)
+}
+
+func (c Range[T]) Rand() T {
+	if c.From == c.To {
+		return c.From
+	}
+	bigInt, _ := rand.Int(rand.Reader, big.NewInt(int64(c.To-c.From)))
+	return c.From + T(bigInt.Int64())
+}
