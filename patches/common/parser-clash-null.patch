@@ -0,0 +1,42 @@
+package parser
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Subscription content is untrusted remote input: provider/remote fetches it in
+// a background goroutine, so a panic here takes down the whole process.
+//
+// An explicit YAML null document ("null", "~", "---", ...) must be rejected
+// gracefully. Before this guard, ParseClashSubscription passed **ClashConfig to
+// yaml.Unmarshal, and yaml.v3 nils the pointer itself for a null document while
+// returning no error, so the following config.Proxies dereferenced nil.
+func TestParseClashSubscriptionNullDocument(t *testing.T) {
+	for _, content := range []string{"null", "~", "---", "--- null", "Null", "NULL"} {
+		t.Run(content, func(t *testing.T) {
+			require.NotPanics(t, func() {
+				outbounds, endpoints, err := ParseClashSubscription(context.Background(), content)
+				if err == nil {
+					require.Empty(t, outbounds)
+					require.Empty(t, endpoints)
+				}
+			})
+		})
+	}
+}
+
+// The same input must also survive the real entry point, which is the one
+// provider/remote and provider/local actually call.
+func TestParseSubscriptionNullDocument(t *testing.T) {
+	for _, content := range []string{"null", "~", "---", "--- null", "Null", "NULL"} {
+		t.Run(content, func(t *testing.T) {
+			require.NotPanics(t, func() {
+				_, _, err := ParseSubscription(context.Background(), content, nil, nil, nil, "test")
+				require.Error(t, err)
+			})
+		})
+	}
+}
