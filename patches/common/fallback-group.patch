+package group
+
+import (
+	"context"
+	"io"
+	"net"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+// Fallback outbound group, ported from shtorm-7/sing-box-extended
+// (protocol/group/fallback.go) and adapted to both reF1nd branches:
+//   - reF1nd-stable: OutboundGroup = {Now, All}; the route manager dials the
+//     group directly, so failover runs inside DialContext/ListenPacket
+//     (dial failure -> blacklist). Lifecycle: the stable outbound manager
+//     starts non-Lifecycle outbounds through a plain `Start() error`
+//     interface, provided by reF1nd_Stable/fallback-group-lifecycle.patch.
+//   - reF1nd-testing: OutboundGroup = {All, Selected, AttachConnection};
+//     route resolves members via Selected, and chain dial failures are
+//     reported through adapter.ConnectionFailureListener (route/conn.go
+//     notifyConnectionFailure). The scope-based adapter.Lifecycle Start and
+//     the chain-aware failure listener (which needs testing-only chain
+//     metadata) are appended by reF1nd_Testing/fallback-group-lifecycle.patch.
+//
+// AttachConnection is a no-op: this group never interrupts existing
+// connections (faithful to the upstream shtorm-7 implementation).
+func RegisterFallback(registry *outbound.Registry) {
+	outbound.Register[option.FallbackOutboundOptions](registry, C.TypeFallback, NewFallback)
+}
+
+var _ adapter.OutboundGroup = (*Fallback)(nil)
+
+type Fallback struct {
+	outbound.Adapter
+	ctx              context.Context
+	outbound         adapter.OutboundManager
+	logger           logger.ContextLogger
+	tags             []string
+	outbounds        map[string]adapter.Outbound
+	lastUsedOutbound string
+	blacklistTimeout time.Duration
+	blacklist        map[string]time.Time
+	mtx              sync.Mutex
+}
+
+// Blacklisting is deliberately error-agnostic: any member dial error other
+// than a client-side cancellation counts against that member for the whole
+// blacklist timeout. A member's DialContext surfaces the end-to-end error, so
+// a destination-side refusal/reset is indistinguishable from a dead node here.
+// adapter.ConnectionFailureListener carries no error value either, so the
+// testing chain listener cannot classify more precisely. Classification (e.g.
+// only net.Error timeouts) would need an interface change and a shorter
+// soft-penalty tier; until then the short default timeout is the mitigation.
+//
+// fallbackMember is a resolved (tag, outbound) pair. DialContext and
+// ListenPacket snapshot members into a local slice of these while holding
+// mtx, so the dial loops never touch the member map concurrently with
+// resolveMembersLocked (which writes and deletes entries on every
+// provider/subscription update).
+type fallbackMember struct {
+	tag      string
+	outbound adapter.Outbound
+}
+
+func NewFallback(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.FallbackOutboundOptions) (adapter.Outbound, error) {
+	if len(options.Outbounds) == 0 {
+		return nil, E.New("missing tags")
+	}
+	// 2026-10-09: the option is a pointer so "omitted" and "explicitly 0" are
+	// distinguishable. Omitted keeps the 1 minute default; an explicit 0 now
+	// really disables the blacklist (the guards in isBlacklisted/addToBlacklist
+	// used to be unreachable dead code because 0 was rewritten to 1m here).
+	blacklistTimeout := time.Minute
+	if options.BlacklistTimeout != nil {
+		blacklistTimeout = time.Duration(*options.BlacklistTimeout)
+		if blacklistTimeout < 0 {
+			return nil, E.New("blacklist_timeout must not be negative")
+		}
+	}
+	outbound := &Fallback{
+		Adapter:          outbound.NewAdapter(C.TypeFallback, tag, []string{N.NetworkTCP, N.NetworkUDP}, options.Outbounds),
+		ctx:              ctx,
+		outbound:         service.FromContext[adapter.OutboundManager](ctx),
+		logger:           logger,
+		tags:             options.Outbounds,
+		outbounds:        make(map[string]adapter.Outbound, len(options.Outbounds)),
+		lastUsedOutbound: options.Outbounds[0],
+		blacklistTimeout: blacklistTimeout,
+		blacklist:        make(map[string]time.Time),
+	}
+	return outbound, nil
+}
+
+// start eagerly resolves the member table, failing loudly on unknown tags.
+// Called by the per-branch Start wrapper (see the file header).
+func (s *Fallback) start() error {
+	s.mtx.Lock()
+	defer s.mtx.Unlock()
+	if s.outbound == nil {
+		// 2026-10-09: resolveMembersLocked() guards this case, start() did not,
+		// so a nil manager (context without a service registry) panicked here
+		// instead of returning the error this function promises.
+		return E.New("missing outbound manager")
+	}
+	for i, tag := range s.tags {
+		outbound, loaded := s.outbound.Outbound(tag)
+		if !loaded {
+			return E.New("outbound ", i, " not found: ", tag)
+		}
+		s.outbounds[tag] = outbound
+	}
+	return nil
+}
+
+// resolveMembersLocked refreshes member pointers from the outbound manager.
+// This runs on every access, not only at Start, for two reasons:
+//  1. Provider subscription updates replace same-tag outbound instances
+//     (outbound.Manager.Replace); a table built once would keep dialing
+//     the closed old instances forever.
+//  2. It lazily completes the table when Start could not resolve a member
+//     yet (e.g. a provider member registered after the group started).
+func (s *Fallback) resolveMembersLocked() {
+	if s.outbound == nil {
+		return
+	}
+	for _, tag := range s.tags {
+		if outbound, loaded := s.outbound.Outbound(tag); loaded {
+			if s.outbounds[tag] != outbound {
+				s.outbounds[tag] = outbound
+			}
+		} else if s.outbounds[tag] != nil {
+			// 成员已从 manager 移除（provider 订阅更新删除节点）：丢弃已关闭
+			// 的陈旧实例，让 nil 守卫按"未就绪"跳过，而不是永远拨打死实例
+			delete(s.outbounds, tag)
+		}
+	}
+}
+
+func (s *Fallback) Now() string {
+	s.mtx.Lock()
+	defer s.mtx.Unlock()
+	return s.lastUsedOutbound
+}
+
+func (s *Fallback) All() []string {
+	s.mtx.Lock()
+	defer s.mtx.Unlock()
+	// 2026-10-09: s.tags aliases options.Outbounds, so returning it directly both
+	// raced the lock-free read against resolveMembersLocked and handed callers a
+	// slice they could mutate in place (selector.go clones for the same reason).
+	return slices.Clone(s.tags)
+}
+
+func (s *Fallback) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	s.mtx.Lock()
+	s.resolveMembersLocked()
+	// 2026-10-09：成员指针必须在锁内解析成局部切片。原实现在 Unlock 之后
+	// 二次读取 s.outbounds[tag]（守卫一次、调用一次），而 resolveMembersLocked
+	// 会在订阅/provider 更新时于其他 goroutine 持锁写入(:111)或删除(:116)
+	// 同一张 map —— 既触发 Go 运行时的 concurrent map read and map write
+	// （不可恢复，整个进程崩溃），也存在 delete 落在两次读取之间时读到零值
+	// adapter.Outbound 接口、调用解引用 nil itab 的 SIGSEGV。局部切片一经
+	// 构造即与 map 解耦，后续只遍历它。
+	var active, blacklisted []fallbackMember
+	seen := make(map[string]bool, len(s.tags))
+	for _, tag := range s.tags {
+		if seen[tag] {
+			// 配置里重复的 tag：快照在写入任何黑名单项之前就构造完毕，
+			// 故同一成员会在同一轮里被拨号两次。去重后每个成员每轮只试一次。
+			continue
+		}
+		seen[tag] = true
+		outbound, loaded := s.outbounds[tag]
+		if !loaded || outbound == nil || !common.Contains(outbound.Network(), network) {
+			// 网络不支持/成员未就绪是配置属性而非故障：跳过且不拉黑
+			continue
+		}
+		member := fallbackMember{tag: tag, outbound: outbound}
+		if s.isBlacklisted(tag) {
+			blacklisted = append(blacklisted, member)
+		} else {
+			active = append(active, member)
+		}
+	}
+	s.mtx.Unlock()
+
+	var err error // last dial failure; nil while no dial has been attempted
+	for _, member := range active {
+		var conn net.Conn
+		conn, err = member.outbound.DialContext(ctx, network, destination)
+		if err != nil {
+			s.logger.InfoContext(ctx, err)
+			if ctx.Err() != nil {
+				// 客户端侧取消/超时：失败归因于本端而非节点——不拉黑，终止轮询
+				return nil, err
+			}
+			s.mtx.Lock()
+			s.addToBlacklist(member.tag)
+			s.mtx.Unlock()
+			continue
+		}
+		s.mtx.Lock()
+		s.lastUsedOutbound = member.tag
+		s.mtx.Unlock()
+		return conn, nil
+	}
+	for _, member := range blacklisted {
+		var conn net.Conn
+		conn, err = member.outbound.DialContext(ctx, network, destination)
+		if err != nil {
+			s.logger.InfoContext(ctx, err)
+			if ctx.Err() != nil {
+				// 客户端侧取消/超时：失败归因于本端而非节点——不拉黑，
+				// 也不再继续拨号（活动轮已有同型守卫，兜底轮此前缺失，
+				// 导致 ctx 已取消时仍会把全部成员拨一遍）。
+				return nil, err
+			}
+			continue
+		}
+		s.mtx.Lock()
+		delete(s.blacklist, member.tag)
+		s.lastUsedOutbound = member.tag
+		s.mtx.Unlock()
+		return conn, nil
+	}
+	if err == nil {
+		// No dial was ever attempted (every member unsupported/absent and
+		// nothing blacklisted): never return a nil conn with a nil error —
+		// callers would treat that as success.
+		err = E.New("no outbound in group supports ", network)
+	}
+	return nil, err
+}
+
+// Selected returns the first non-blacklisted outbound in configured order.
+// Only used by the reF1nd-testing routing model (resolveOutbound).
+func (s *Fallback) Selected(network string) adapter.Outbound {
+	s.mtx.Lock()
+	defer s.mtx.Unlock()
+	s.resolveMembersLocked()
+	for _, tag := range s.tags {
+		if s.isBlacklisted(tag) {
+			continue
+		}
+		if outbound, ok := s.outbounds[tag]; ok {
+			// 2026-10-06：跳过不支持请求网络的成员——上游路由对解析出的
+			// 成员做网络检查，首成员不支持时整条连接直接失败，组内后续
+			// 成员永无机会（故障转移失效）
+			if !common.Contains(outbound.Network(), network) {
+				continue
+			}
+			s.lastUsedOutbound = tag
+			return outbound
+		}
+	}
+	// 2026-10-07：全部成员被拉黑或不支持时，原实现固定回退 tags[0]——若其
+	// 不支持请求网络，即使存在支持该网络（虽被拉黑）的成员，连接也会在上游
+	// 的网络检查处失败。第二遍忽略黑名单、仅要求网络支持，与 DialContext
+	// 的兜底轮语义对齐：黑名单是偏好，不是硬过滤。
+	for _, tag := range s.tags {
+		if outbound, ok := s.outbounds[tag]; ok && common.Contains(outbound.Network(), network) {
+			s.lastUsedOutbound = tag
+			return outbound
+		}
+	}
+	// 全部成员都不支持请求网络：回退首成员，由上游给出明确的 not supported 错误
+	if outbound, ok := s.outbounds[s.tags[0]]; ok {
+		return outbound
+	}
+	return nil
+}
+
+// AttachConnection satisfies adapter.OutboundGroup on reF1nd-testing.
+// This group never interrupts existing connections, so the closer is
+// discarded and the detach function is a no-op.
+func (s *Fallback) AttachConnection(io.Closer) func() {
+	return func() {}
+}
+
+func (s *Fallback) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	s.mtx.Lock()
+	s.resolveMembersLocked()
+	// 2026-10-09：同 DialContext —— 成员指针在锁内解析成局部切片，解锁后
+	// 不再触碰 s.outbounds map（并发读写会 fatal，二次读取会 SIGSEGV）。
+	var active, blacklisted []fallbackMember
+	seen := make(map[string]bool, len(s.tags))
+	for _, tag := range s.tags {
+		if seen[tag] {
+			// 同 DialContext：重复 tag 会让同一成员在一轮里被监听两次
+			continue
+		}
+		seen[tag] = true
+		outbound, loaded := s.outbounds[tag]
+		if !loaded || outbound == nil || !common.Contains(outbound.Network(), N.NetworkUDP) {
+			continue
+		}
+		member := fallbackMember{tag: tag, outbound: outbound}
+		if s.isBlacklisted(tag) {
+			blacklisted = append(blacklisted, member)
+		} else {
+			active = append(active, member)
+		}
+	}
+	s.mtx.Unlock()
+
+	var err error // last dial failure; nil while no dial has been attempted
+	for _, member := range active {
+		var conn net.PacketConn
+		conn, err = member.outbound.ListenPacket(ctx, destination)
+		if err != nil {
+			s.logger.InfoContext(ctx, err)
+			if ctx.Err() != nil {
+				return nil, err
+			}
+			s.mtx.Lock()
+			s.addToBlacklist(member.tag)
+			s.mtx.Unlock()
+			continue
+		}
+		s.mtx.Lock()
+		s.lastUsedOutbound = member.tag
+		s.mtx.Unlock()
+		return conn, nil
+	}
+	for _, member := range blacklisted {
+		var conn net.PacketConn
+		conn, err = member.outbound.ListenPacket(ctx, destination)
+		if err != nil {
+			s.logger.InfoContext(ctx, err)
+			if ctx.Err() != nil {
+				// 同 DialContext 的兜底轮守卫
+				return nil, err
+			}
+			continue
+		}
+		s.mtx.Lock()
+		delete(s.blacklist, member.tag)
+		s.lastUsedOutbound = member.tag
+		s.mtx.Unlock()
+		return conn, nil
+	}
+	if err == nil {
+		// See DialContext: never return a nil PacketConn with a nil error.
+		err = E.New("no outbound in group supports ", N.NetworkUDP)
+	}
+	return nil, err
+}
+
+func (s *Fallback) isBlacklisted(tag string) bool {
+	if s.blacklistTimeout == 0 {
+		return false
+	}
+	expiry, ok := s.blacklist[tag]
+	if !ok {
+		return false
+	}
+	if time.Now().After(expiry) {
+		delete(s.blacklist, tag)
+		return false
+	}
+	return true
+}
+
+func (s *Fallback) addToBlacklist(tag string) {
+	if s.blacklistTimeout > 0 {
+		s.blacklist[tag] = time.Now().Add(s.blacklistTimeout)
+	}
+}
